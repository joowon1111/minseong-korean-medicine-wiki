path": "assets/provenance/search-batches/055.json", "documents": 24}, {"path": "assets/provenance/search-batches/056.json", "documents": 24}, {"path": "assets/provenance/search-batches/057.json", "documents": 24}, {"path": "assets/provenance/search-batches/058.json", "documents": 24}, {"path": "assets/provenance/search-batches/059.json", "documents": 24}, {"path": "assets/provenance/search-batches/060.json", "documents": 24}, {"path": "assets/provenance/search-batches/061.json", "documents": 24}, {"path": "assets/provenance/search-batches/062.json", "documents": 24}, {"path": "assets/provenance/search-batches/063.json", "documents": 24}, {"path": "assets/provenance/search-batches/064.json", "documents": 24}, {"path": "assets/provenance/search-batches/065.json", "documents": 24}, {"path": "assets/provenance/search-batches/066.json", "documents": 24}, {"path": "assets/provenance/search-batches/067.json", "documents": 24}, {"path": "assets/provenance/search-batches/068.json", "documents": 24}, {"path": "assets/provenance/search-batches/069.json", "documents": 24}, {"path": "assets/provenance/search-batches/070.json", "documents": 24}, {"path": "assets/provenance/search-batches/071.json", "documents": 24}, {"path": "assets/provenance/search-batches/072.json", "documents": 24}, {"path": "assets/provenance/search-batches/073.json", "documents": 24}, {"path": "assets/provenance/search-batches/074.json", "documents": 24}, {"path": "assets/provenance/search-batches/075.json", "documents": 24}, {"path": "assets/provenance/search-batches/076.json", "documents": 24}, {"path": "assets/provenance/search-batches/077.json", "documents": 24}, {"path": "assets/provenance/search-batches/078.json", "documents": 24}, {"path": "assets/provenance/search-batches/079.json", "documents": 24}, {"path": "assets/provenance/search-batches/080.json", "documents": 24}, {"path": "assets/provenance/search-batches/081.json", "documents": 3}], "core_documents": [{"document_id": "MSA-3D34C5370E9FCAB6", "url": "https://wiki.minseong.co.kr/conditions/dry-eye/", "title": "안구건조증 — 눈물막·눈꺼풀 관리와 침·한약", "source_path": "conditions/dry-eye.md", "text_sha256": "edb838b051d5d433443174515264a7a1c9c467f553bab256bfb39a0ef9d88346", "source_sha256": "3106f2118b3bac2632322b2c7dc3c9548c9e914e69d12dbc94fe740760f0320b", "search_samples": ["안구건조증은 눈물이 충분히 만들어지지 않거나 눈물막이 빨리 깨져 눈 표면의 촉촉함이 유지되지 않는 상태입니다. 건조감·이물감·작열감·시림뿐 아니라 깜빡이면 잠시 맑아지는 흐림, 화면 작업의 어려움도", "약침은 제제와 부위 선택 원칙에 따라 치료 목표를 정합니다. 목·턱 통증이 동반되면 통증·움직임을 별도로 평가하고, 안구표면 증상을 목표로 하는 경우에는 사용 제제·시술 부위·병행 점안과 OSDI ", "안구건조 · 눈이 뻑뻑해요 · 눈이 시려요 · 눈에 모래가 들어간 느낌 · 컴퓨터 보면 눈이 건조해요 · 눈물흘림 · 눈물이 나요 · 유루증 · 반사성 눈물 · Dry Eye"], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}, {"document_id": "MSA-5B6A5072DF5CD2C1", "url": "https://wiki.minseong.co.kr/conditions/dyspepsia/", "title": "소화불량·더부룩함", "source_path": "conditions/dyspepsia.md", "text_sha256": "1374f41059cb1b153428af23461e5b6ec1032513d6e3c05e39dedecc14db3229", "source_sha256": "4ed6f95210c5818eb4794a105df201bf1d53d71277066f31f334359717d22abb", "search_samples": ["소화불량은 단순히 “소화가 안 된다”는 한 가지 병명이 아닙니다. 식후에 오래 남는 더부룩함, 몇 숟갈만 먹어도 배가 차는 조기포만, 명치 통증·화끈거림, 트림·메스꺼움이 서로 다른 비중으로 나타나", "혈자리는 고정 세트가 아니라 환자의 주증상과 압통, 체력, 병력에 따라 선택합니다. 2024년 베이지안 네트워크 메타분석은 침 단독·복합 치료가 기능성 소화불량 증상에 도움이 될 가능성을 보고했습니", "Xu Z, et al. Efficacy of acupuncture for anxiety and depression in functional dyspepsia: a systematic review a"], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}, {"document_id": "MSA-85EF4A4C069F9CB9", "url": "https://wiki.minseong.co.kr/conditions/eye-fatigue/", "title": "눈피로·안구피로: 화면 작업, 건조와 한의치료", "source_path": "conditions/eye-fatigue.md", "text_sha256": "495e9467c8c5c05cd0d3f521934530e9c95ed8db6061f83f8087b28a360e2c19", "source_sha256": "25fc1f4b9b01c4dbe1689183fa0c2a8ed64873c66547345237926e2d20410eae", "search_samples": ["눈피로는 오래 읽거나 화면을 본 뒤 눈이 무겁고 뻐근해지며, 초점 맞추기가 힘들거나 건조감·두통이 겹치는 증상입니다. 한의치료에서는 눈 주변의 불편, 목·어깨의 긴장, 수면과 회복 상태를 함께 살펴", "예를 들어 눈썹 주변 불편과 목 긴장이 함께 있으면 국소 경혈과 경항부 평가를 연결하고, 건조가 중심이면 안구표면 관리와 침치료 경과를 함께 봅니다. 배혈은 고정된 세트가 아니라 불편 부위와 동반 ", "눈피로에 건조가 겹치는 경우에는 안구건조증 본문의 비교군별 침·한약 임상연구를 이어서 볼 수 있습니다. 2024년 체계적 문헌고찰의 초록에서는 16개 시험·1,383명을 정리했고, 침과 인공눈물을 "], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}, {"document_id": "MSA-1BC3ED5AE8F9292F", "url": "https://wiki.minseong.co.kr/conditions/facial-palsy/", "title": "안면마비·구안와사: 초기 치료·눈 보호·회복과 후유증", "source_path": "conditions/facial-palsy.md", "text_sha256": "dd32b0a3f71e2bd597b04db4bcb334c47ba5536530229f5d703b29625a99b8b6", "source_sha256": "afb99cece5a1c6ed35b2158da49640f398e4fdbcae75113e7e8d565f35312fe5", "search_samples": ["갑자기 한쪽 얼굴이 움직이지 않거나 눈이 감기지 않으면 발병 시점·동반 신경 증상·눈 보호부터 확인합니다. 벨마비의 초기 72시간 치료를 놓치지 않으면서 한약·침·전침·약침과 회복 단계별 재활을 함", "Zhang 등은 15개 RCT·771명으로 보고했습니다. 대상은 발병 7일 이내 특발성 말초성 마비이며 람세이헌트·외상성 마비는 제외했습니다. 급성기에 침을 시작한 군과 그때는 침 없이 약물 등으로", "안면마비 · 구안와사 · 입이 돌아갔어요 · 한쪽 얼굴이 안 움직여요 · 눈이 안 감겨요 · 벨마비 · 말초성 안면신경마비 · 안면마비 한약 · 안면마비 침치료 · 안면 연합운동 · Facial N"], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}, {"document_id": "MSA-10952444840FCEF7", "url": "https://wiki.minseong.co.kr/conditions/hair-loss/", "title": "탈모·머리카락이 많이 빠져요", "source_path": "conditions/hair-loss.md", "text_sha256": "4cf632f49d9536c43d3849504f1c0dcbf8442552b15fa9244a2930f61f8577ea", "source_sha256": "10cf8414c32aab8a30ec7dd814ca93bd003b8bad8a26ed1ea67507d08d5fc782", "search_samples": ["탈모는 모발이 가늘어지는 패턴, 빠지는 시점, 모낭 입구의 보존 여부를 먼저 구분합니다. 유전적 모낭 축소가 중심인 남성형·여성형, 자가면역성 원형탈모, 질병·출산·감량 뒤의 휴지기탈모, 모낭이 파", "임상에서는 백회(GV20)·사신총(EX-HN1)과 두피 주변점, 합곡(LI4)·족삼리(ST36)·삼음교(SP6)·태충(LR3) 등을 진찰과 동반 증후에 맞춰 조합합니다. 국소 두피 치료와 수면·긴장", "Song YW 등. A Case Study of Stress-Induced Alopecia Areata Treated with Hominis Placenta Pharmacopunture. Journ"], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}, {"document_id": "MSA-59C80A9625A191C9", "url": "https://wiki.minseong.co.kr/conditions/low-back-pain/", "title": "허리통증·요통 — 원인별 치료와 운동·스트레칭", "source_path": "conditions/low-back-pain.md", "text_sha256": "3f8f8ce5c9a92d84fed5a17bc1ba0def9638f41f073415771062c52c6bebb1dc", "source_sha256": "0210f80ea5236a9e52b14c98497ea5e35e71d3e2b415936a9b40e49df6d29e97", "search_samples": ["허리통증은 무거운 물건을 들다 삐끗한 급성 염좌부터 오래 앉을 때 뻐근한 만성요통, 엉덩이와 다리로 이어지는 신경근 통증까지 범위가 넓습니다. 영상에서 디스크나 협착이 보여도 현재 통증과 반드시 일", "WHO 2023 만성 일차성 요통 지침은 침을 포함해 교육·운동·일부 물리적·심리적 치료를 환자 중심의 통합 관리 안에서 고려합니다. 한 가지 치료에만 의존하기보다 통증을 낮추고 활동을 회복하는 조", "허리·다리 증상은 방사통의 경로와 앉기·서기·보행의 차이를 함께 확인합니다. 원인별 안내에서 신경학적 평가와 변증·한약·침치료, 보행 회복으로 이어갈 수 있습니다."], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}, {"document_id": "MSA-8F4D1843216FB022", "url": "https://wiki.minseong.co.kr/conditions/neck-pain/", "title": "목통증·경항통 — 원인별 치료와 운동·생활관리", "source_path": "conditions/neck-pain.md", "text_sha256": "09e82bcd08e7f40d3a5389b11c6123bf54128410e9f284555ac63d63a1ffcdb6", "source_sha256": "119165e8219350eb881ff941d2349cb9fb5536def86bef12c92b5d33a130bb78", "search_samples": ["목통증은 “목이 뻐근하다”, “담이 들었다”, “뒷골이 당긴다”, “고개가 안 돌아간다”처럼 다양하게 표현됩니다. 통증이 목에만 머물기도 하고 어깨·견갑골·팔로 이어지거나 두통과 어지럼을 동반하기도", "아래는 낮은 부하로 시작하는 예시입니다. 모든 동작을 한 번에 할 필요는 없으며, 처음에는 1~2가지를 고릅니다. 팔저림이 있거나 사고·수술 후 상태라면 먼저 운동 방향을 평가합니다.", "침·전침의 추가 종합자료: Seo SY, et al. Effectiveness of Acupuncture and Electroacupuncture for Chronic Neck Pain. 2017."], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}, {"document_id": "MSA-599F327324AEFBD4", "url": "https://wiki.minseong.co.kr/conditions/shoulder-pain/", "title": "어깨통증 — 오십견·회전근개 감별과 치료·운동", "source_path": "conditions/shoulder-pain.md", "text_sha256": "34e84ff88440d4a95257f589c5fa531857f7551b562d05683149baac0ae4d8fe", "source_sha256": "b73fd1958236210ea15fd82dba85b58771a9d22ed386f02949c44b70542031e2", "search_samples": ["어깨가 아파 자다가 깨거나, 침치료 뒤 편해졌다가 같은 통증이 반복될 수 있습니다. “만세가 잘 안 된다”, “재킷을 입을 때 팔을 뒤로 돌리기 어렵다”, “머리를 감거나 선반에서 물건을 꺼낼 때 ", "야간통을 줄이고 수면을 회복하는 것이 우선입니다. 강제로 끝범위까지 꺾는 운동보다 통증을 크게 올리지 않는 범위의 가벼운 진자운동과 침·전침·약침 등의 진통 치료를 조합합니다.", "어깨가 굳는 양상, 팔을 들고 버티기 어려운 양상, 쥘 때 팔꿈치가 아픈 양상을 비교합니다. 신경 증상과 힘줄·관절 기능을 확인하고 한약·침구치료와 부하 조절을 연결합니다."], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}, {"document_id": "MSA-7E24E119966FA330", "url": "https://wiki.minseong.co.kr/formulas/gyeongok-go/", "title": "경옥고: 구성 약재, 동의보감 원문과 임상연구", "source_path": "formulas/gyeongok-go.md", "text_sha256": "55fc98abef01e4fba36c8641d36cd749fa1b0280e46a2b3e8a517dff539b92d3", "source_sha256": "0c9874c25c482b28c33e235c2a20cd70be2465dc5fb4c3f39ab4779267a1273d", "search_samples": ["경옥고는 인삼·생지황·복령·봉밀 네 재료를 오랜 시간 조화시켜 만드는 《동의보감》의 대표적인 양생·보익 고제(膏劑)입니다. 기운만 보하는 것이 아니라 기와 진액, 소화의 바탕과 윤조를 함께 고려한다", "롱코비드로 12주 이상 피로가 이어진 성인 100명의 다기관 전향적 연구에서 94명이 12주 과정을 마쳤습니다. 피로심각도척도(FSS)는 복용 전보다 평균 2.1점 낮아졌고 수면 관련 지표도 개선돼", "Yoon J, et al. Kyungok-go for fatigue in patients with long COVID: Double-blind, randomized, multicenter, pilo"], "commit": "c63f80a6f8d8cf2f17f3ba250192eea1f0fd5076", "committed_at": "2026-10-27T10:37:04+09:00"}], "selection": "Choose a rotating batch using the current ISO week number modulo batch count; vary documents and phrases, and verify candidates manually."}
