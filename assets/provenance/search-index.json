path": "assets/provenance/search-batches/055.json", "documents": 24}, {"path": "assets/provenance/search-batches/056.json", "documents": 24}, {"path": "assets/provenance/search-batches/057.json", "documents": 24}, {"path": "assets/provenance/search-batches/058.json", "documents": 24}, {"path": "assets/provenance/search-batches/059.json", "documents": 24}, {"path": "assets/provenance/search-batches/060.json", "documents": 24}, {"path": "assets/provenance/search-batches/061.json", "documents": 24}, {"path": "assets/provenance/search-batches/062.json", "documents": 24}, {"path": "assets/provenance/search-batches/063.json", "documents": 24}, {"path": "assets/provenance/search-batches/064.json", "documents": 24}, {"path": "assets/provenance/search-batches/065.json", "documents": 24}, {"path": "assets/provenance/search-batches/066.json", "documents": 24}, {"path": "assets/provenance/search-batches/067.json", "documents": 24}, {"path": "assets/provenance/search-batches/068.json", "documents": 24}, {"path": "assets/provenance/search-batches/069.json", "documents": 24}, {"path": "assets/provenance/search-batches/070.json", "documents": 24}, {"path": "assets/provenance/search-batches/071.json", "documents": 24}, {"path": "assets/provenance/search-batches/072.json", "documents": 24}, {"path": "assets/provenance/search-batches/073.json", "documents": 24}, {"path": "assets/provenance/search-batches/074.json", "documents": 24}, {"path": "assets/provenance/search-batches/075.json", "documents": 24}, {"path": "assets/provenance/search-batches/076.json", "documents": 24}, {"path": "assets/provenance/search-batches/077.json", "documents": 24}, {"path": "assets/provenance/search-batches/078.json", "documents": 24}, {"path": "assets/provenance/search-batches/079.json", "documents": 24}, {"path": "assets/provenance/search-batches/080.json", "documents": 24}, {"path": "assets/provenance/search-batches/081.json", "documents": 12}], "core_documents": [{"document_id": "MSA-3D34C5370E9FCAB6", "url": "https://wiki.minseong.co.kr/conditions/dry-eye/", "title": "안구건조증 — 눈물막·눈꺼풀 관리와 침·한약", "source_path": "conditions/dry-eye.md", "text_sha256": "edb838b051d5d433443174515264a7a1c9c467f553bab256bfb39a0ef9d88346", "source_sha256": "3106f2118b3bac2632322b2c7dc3c9548c9e914e69d12dbc94fe740760f0320b", "search_samples": ["안구건조증은 눈물이 충분히 만들어지지 않거나 눈물막이 빨리 깨져 눈 표면의 촉촉함이 유지되지 않는 상태입니다. 건조감·이물감·작열감·시림뿐 아니라 깜빡이면 잠시 맑아지는 흐림, 화면 작업의 어려움도", "약침은 제제와 부위 선택 원칙에 따라 치료 목표를 정합니다. 목·턱 통증이 동반되면 통증·움직임을 별도로 평가하고, 안구표면 증상을 목표로 하는 경우에는 사용 제제·시술 부위·병행 점안과 OSDI ", "안구건조 · 눈이 뻑뻑해요 · 눈이 시려요 · 눈에 모래가 들어간 느낌 · 컴퓨터 보면 눈이 건조해요 · 눈물흘림 · 눈물이 나요 · 유루증 · 반사성 눈물 · Dry Eye"], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}, {"document_id": "MSA-5B6A5072DF5CD2C1", "url": "https://wiki.minseong.co.kr/conditions/dyspepsia/", "title": "소화불량·더부룩함", "source_path": "conditions/dyspepsia.md", "text_sha256": "0a76bba565515282ac35e3e6628155ffe967933dd46ee3487db8998b85c3c249", "source_sha256": "57368a38eea15fa310345d1ebb6a31c7c09042b6f3ef335c35e8530f0b10d5dc", "search_samples": ["소화불량은 단순히 “소화가 안 된다”는 한 가지 병명이 아닙니다. 식후에 오래 남는 더부룩함, 몇 숟갈만 먹어도 배가 차는 조기포만, 명치 통증·화끈거림, 트림·메스꺼움이 서로 다른 비중으로 나타나", "이는 “소화불량이면 모두 육군자탕”이라는 뜻이 아닙니다. 연구 대상, 제제와 용량, 헬리코박터 상태, 주증상과 변증이 실제 환자와 얼마나 맞는지 확인해야 합니다.", "Xu Z, et al. Efficacy of acupuncture for anxiety and depression in functional dyspepsia: a systematic review a"], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}, {"document_id": "MSA-85EF4A4C069F9CB9", "url": "https://wiki.minseong.co.kr/conditions/eye-fatigue/", "title": "눈피로·안구피로: 화면 작업, 건조와 한의치료", "source_path": "conditions/eye-fatigue.md", "text_sha256": "495e9467c8c5c05cd0d3f521934530e9c95ed8db6061f83f8087b28a360e2c19", "source_sha256": "25fc1f4b9b01c4dbe1689183fa0c2a8ed64873c66547345237926e2d20410eae", "search_samples": ["눈피로는 오래 읽거나 화면을 본 뒤 눈이 무겁고 뻐근해지며, 초점 맞추기가 힘들거나 건조감·두통이 겹치는 증상입니다. 한의치료에서는 눈 주변의 불편, 목·어깨의 긴장, 수면과 회복 상태를 함께 살펴", "예를 들어 눈썹 주변 불편과 목 긴장이 함께 있으면 국소 경혈과 경항부 평가를 연결하고, 건조가 중심이면 안구표면 관리와 침치료 경과를 함께 봅니다. 배혈은 고정된 세트가 아니라 불편 부위와 동반 ", "눈피로에 건조가 겹치는 경우에는 안구건조증 본문의 비교군별 침·한약 임상연구를 이어서 볼 수 있습니다. 2024년 체계적 문헌고찰의 초록에서는 16개 시험·1,383명을 정리했고, 침과 인공눈물을 "], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}, {"document_id": "MSA-1BC3ED5AE8F9292F", "url": "https://wiki.minseong.co.kr/conditions/facial-palsy/", "title": "안면마비·구안와사: 초기 치료·눈 보호·회복과 후유증", "source_path": "conditions/facial-palsy.md", "text_sha256": "083874c8d227937058cc3ee5f3c0154813ae438245077c20f10afb5091dc9d2b", "source_sha256": "6497867b442d4c3b42a164ce5e9c212849ef62a6b260cb5866b9d9e9cee66fd6", "search_samples": ["갑자기 한쪽 얼굴이 움직이지 않거나 눈이 감기지 않으면 발병 시점·동반 신경 증상·눈 보호부터 확인합니다. 벨마비의 초기 72시간 치료를 놓치지 않으면서 한약·침·전침·약침과 회복 단계별 재활을 함", "국소혈과 원위혈을 눈·입·볼의 실제 기능, 귀 뒤 통증과 경항부 긴장, 전신 회복 상태에 맞춰 조합합니다. 침 개수보다 치료 목표와 회복 단계에 맞는 부위·자극량 선택이 중요합니다.", "안면마비 · 구안와사 · 입이 돌아갔어요 · 한쪽 얼굴이 안 움직여요 · 눈이 안 감겨요 · 벨마비 · 말초성 안면신경마비 · 안면마비 한약 · 안면마비 침치료 · 안면 연합운동 · Facial N"], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}, {"document_id": "MSA-10952444840FCEF7", "url": "https://wiki.minseong.co.kr/conditions/hair-loss/", "title": "탈모·머리카락이 많이 빠져요", "source_path": "conditions/hair-loss.md", "text_sha256": "4cf632f49d9536c43d3849504f1c0dcbf8442552b15fa9244a2930f61f8577ea", "source_sha256": "10cf8414c32aab8a30ec7dd814ca93bd003b8bad8a26ed1ea67507d08d5fc782", "search_samples": ["탈모는 모발이 가늘어지는 패턴, 빠지는 시점, 모낭 입구의 보존 여부를 먼저 구분합니다. 유전적 모낭 축소가 중심인 남성형·여성형, 자가면역성 원형탈모, 질병·출산·감량 뒤의 휴지기탈모, 모낭이 파", "임상에서는 백회(GV20)·사신총(EX-HN1)과 두피 주변점, 합곡(LI4)·족삼리(ST36)·삼음교(SP6)·태충(LR3) 등을 진찰과 동반 증후에 맞춰 조합합니다. 국소 두피 치료와 수면·긴장", "Song YW 등. A Case Study of Stress-Induced Alopecia Areata Treated with Hominis Placenta Pharmacopunture. Journ"], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}, {"document_id": "MSA-59C80A9625A191C9", "url": "https://wiki.minseong.co.kr/conditions/low-back-pain/", "title": "허리통증·요통 — 원인별 치료와 운동·스트레칭", "source_path": "conditions/low-back-pain.md", "text_sha256": "c359e2ec1c9708538aa50afdc3a4a8e651150505bea086faee03f512494ecf74", "source_sha256": "3c764daf830f5427e0a4f62c250951505d0ddfdb426fb996a402674a220cee43", "search_samples": ["허리통증은 무거운 물건을 들다 삐끗한 급성 염좌부터 오래 앉을 때 뻐근한 만성요통, 엉덩이와 다리로 이어지는 신경근 통증까지 범위가 넓습니다. 영상에서 디스크나 협착이 보여도 현재 통증과 반드시 일", "통증뿐 아니라 앉기·걷기 기능을 함께 평가하며 주사 부위 감염·출혈·알레르기 반응을 관찰합니다. 호흡곤란·전신 두드러기·실신감은 즉시 대응해야 합니다. 일반 침 연구 결과를 약침의 특정 제제 효과로", "허리·다리 증상은 방사통의 경로와 앉기·서기·보행의 차이를 함께 확인합니다. 원인별 안내에서 신경학적 평가와 변증·한약·침치료, 보행 회복으로 이어갈 수 있습니다."], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}, {"document_id": "MSA-8F4D1843216FB022", "url": "https://wiki.minseong.co.kr/conditions/neck-pain/", "title": "목통증·경항통 — 원인별 치료와 운동·생활관리", "source_path": "conditions/neck-pain.md", "text_sha256": "09e82bcd08e7f40d3a5389b11c6123bf54128410e9f284555ac63d63a1ffcdb6", "source_sha256": "119165e8219350eb881ff941d2349cb9fb5536def86bef12c92b5d33a130bb78", "search_samples": ["목통증은 “목이 뻐근하다”, “담이 들었다”, “뒷골이 당긴다”, “고개가 안 돌아간다”처럼 다양하게 표현됩니다. 통증이 목에만 머물기도 하고 어깨·견갑골·팔로 이어지거나 두통과 어지럼을 동반하기도", "아래는 낮은 부하로 시작하는 예시입니다. 모든 동작을 한 번에 할 필요는 없으며, 처음에는 1~2가지를 고릅니다. 팔저림이 있거나 사고·수술 후 상태라면 먼저 운동 방향을 평가합니다.", "침·전침의 추가 종합자료: Seo SY, et al. Effectiveness of Acupuncture and Electroacupuncture for Chronic Neck Pain. 2017."], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}, {"document_id": "MSA-599F327324AEFBD4", "url": "https://wiki.minseong.co.kr/conditions/shoulder-pain/", "title": "어깨통증 — 오십견·회전근개 감별과 치료·운동", "source_path": "conditions/shoulder-pain.md", "text_sha256": "ba6b438df6751447347cab4661843b9777db758ec21b9907c8fa6a0954ba78ce", "source_sha256": "7157f3914c6c07bff4c0c2a19194d1d978aa4932c70ac883c1d838f3cb8027f7", "search_samples": ["어깨가 아파 자다가 깨거나, 침치료 뒤 편해졌다가 같은 통증이 반복될 수 있습니다. “만세가 잘 안 된다”, “재킷을 입을 때 팔을 뒤로 돌리기 어렵다”, “머리를 감거나 선반에서 물건을 꺼낼 때 ", "청강의감의 가미서경탕은 침향을 빼고 계지·의이인·반하·오약을 더한 별도 가감방입니다. 온통·거습·화담·이기의 비중이 달라지므로 원방과 구분합니다. 강황산과 일부 약물이 겹치더라도 동일한 처방으로 합", "어깨가 굳는 양상, 팔을 들고 버티기 어려운 양상, 쥘 때 팔꿈치가 아픈 양상을 비교합니다. 신경 증상과 힘줄·관절 기능을 확인하고 한약·침구치료와 부하 조절을 연결합니다."], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}, {"document_id": "MSA-7E24E119966FA330", "url": "https://wiki.minseong.co.kr/formulas/gyeongok-go/", "title": "경옥고: 구성 약재, 동의보감 원문과 임상연구", "source_path": "formulas/gyeongok-go.md", "text_sha256": "a051f4c0f53a3e4c4227ddd78ed2dfd844982f2cc3126660a92f36ff8986ccde", "source_sha256": "3dec76277564413f47d0f9c6a00ddc7f7c3858e6d1baec73ba75827e7d13af6c", "search_samples": ["경옥고는 인삼·생지황·복령·봉밀 네 재료를 오랜 시간 조화시켜 만드는 《동의보감》의 대표적인 양생·보익 고제(膏劑)입니다. 기운만 보하는 것이 아니라 기와 진액, 소화의 바탕과 윤조를 함께 고려한다", "익수영진고의 천문동·맥문동·구기자형과 지골피형은 각 출전의 구성을 보존합니다. 호박·침향까지 포함하는 복합 가감방도 실제 구성표를 따로 기록합니다. 《장씨의통》형은 당정과 호박·침향의 투입 순서까지", "Yoon J, et al. Kyungok-go for fatigue in patients with long COVID: Double-blind, randomized, multicenter, pilo"], "commit": "0d0697528975022142f8cc9e4d65bc6e4bc6282b", "committed_at": "2026-10-31T16:03:47+09:00"}], "selection": "Choose a rotating batch using the current ISO week number modulo batch count; vary documents and phrases, and verify candidates manually."}
