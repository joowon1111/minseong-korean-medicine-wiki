{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-twig","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"계지","@language":"ko"},"skos:altLabel":["桂枝"],"skos:definition":{"@value":"처방의 계지 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cinnamon-twig/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"생강","@language":"ko"},"skos:altLabel":["生薑"],"skos:definition":{"@value":"생강의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/fresh-ginger/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jinkui-06-013","@type":["skos:Concept","km:ClassicalPassage"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"금궤요략 혈비허로 6.13 조문","@language":"ko"},"skos:altLabel":["금궤요략 혈비허로 6.13"],"skos:definition":{"@value":"금궤요략 혈비허로 6.13에서 소건중탕의 처방명을 명시한 고전 조문. 앞뒤 증후와 제시 순서를 함께 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/classics/jinkui-yaolue/chapters/blood-bi-deficiency/#clause-06-013"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"대조","@language":"ko"},"skos:altLabel":["大棗"],"skos:definition":{"@value":"대조의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/jujube-fruit/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maltose","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"교이","@language":"ko"},"skos:altLabel":["膠飴"],"skos:definition":{"@value":"처방의 교이 약미와 본초 문서를 연결하는 개념. 원문 약명·가공·약용 부위와 조제 조건을 각 수록본에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/maltose/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shanghan-100","@type":["skos:Concept","km:ClassicalPassage"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"상한론 제100조 조문","@language":"ko"},"skos:altLabel":["상한론 제100조"],"skos:definition":{"@value":"상한론 제100조에서 소건중탕·소시호탕의 처방명을 명시한 고전 조문. 앞뒤 증후와 제시 순서를 함께 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/classics/shanghanlun/clauses/taiyang-middle/#clause-100"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shaoyao-source-name","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"작약","@language":"ko"},"skos:altLabel":["芍藥"],"skos:definition":{"@value":"처방의 작약 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/white-peony/#processing"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jinkui-06-013--recordsFormula--xiaojianzhong-jinkui","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jinkui-06-013"},"rdf:predicate":{"@id":"km:recordsFormula"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/classics/jinkui-yaolue/chapters/blood-bi-deficiency/#clause-06-013"},"dcterms:description":{"@value":"\u003e 虛勞裏急，悸、衄，腹中痛，夢失精，四肢痠疼，手足煩熱，咽乾口燥，小建中湯主之。"},"skos:scopeNote":{"@value":"小建中湯을 명시한 허로 조문과 금궤의 감초 3량·대조 12매형을 연결한다. 관계는 문헌 수록과 출처를 나타낸다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shanghan-100--recordsFormula--xiaojianzhong-shanghan","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shanghan-100"},"rdf:predicate":{"@id":"km:recordsFormula"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/classics/shanghanlun/clauses/taiyang-middle/#clause-100"},"dcterms:description":{"@value":"\u003e 傷寒，陽脈濇，陰脈弦，法當腹中急痛，先與小建中湯，不差者，與小柴胡湯主之。"},"skos:scopeNote":{"@value":"先與小建中湯의 첫 처방이다. 상한론 송본의 감초 2량·대조 20매형에 연결한다. 관계는 문헌 수록과 출처를 나타낸다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-jinkui--containsHerb--cinnamon-twig","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-twig"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [계지](../herbs/cinnamon-twig.md) · 桂枝 | 3량 / 3량 | 두 수록형 모두 거피 표기. 영위·온통의 축 |"},"skos:scopeNote":{"@value":"금궤요략 소건중탕. 비교표의 상한론 / 금궤 열 중 금궤요략 값을 선택: 桂枝 3량. 포제·제법의 표기: 두 수록형 모두 거피 표기. 영위·온통의 축. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-jinkui--containsHerb--fresh-ginger","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [생강](../herbs/fresh-ginger.md) · 生薑 | 3량 / 3량 | 상한론은 切 표기. 위기·영위의 조화 |"},"skos:scopeNote":{"@value":"금궤요략 소건중탕. 비교표의 상한론 / 금궤 열 중 금궤요략 값을 선택: 生薑 3량. 포제·제법의 표기: 상한론은 切 표기. 위기·영위의 조화. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-jinkui--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | **20매 / 12매** | 상한론은 擘 표기. 중초·영위 조화 |"},"skos:scopeNote":{"@value":"금궤요략 소건중탕. 비교표의 상한론 / 금궤 열 중 금궤요략 값을 선택: 大棗 12매. 포제·제법의 표기: 상한론은 擘 표기. 중초·영위 조화. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-jinkui--containsHerb--licorice","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [감초](../herbs/licorice.md) · 甘草 | **2량 / 3량** | 두 수록형 모두 炙 표기. 작약과 완급·조화 |"},"skos:scopeNote":{"@value":"금궤요략 소건중탕. 비교표의 상한론 / 금궤 열 중 금궤요략 값을 선택: 甘草 3량. 포제·제법의 표기: 두 수록형 모두 炙 표기. 작약과 완급·조화. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-jinkui--containsHerb--maltose","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maltose"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [교이](../herbs/maltose.md) · 膠飴 | 1승 / 1승 | 거재 뒤 녹임. 감온·건중·완급 |"},"skos:scopeNote":{"@value":"금궤요략 소건중탕. 비교표의 상한론 / 금궤 열 중 금궤요략 값을 선택: 膠飴 1승. 포제·제법의 표기: 거재 뒤 녹임. 감온·건중·완급. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-jinkui--containsHerb--shaoyao-source-name","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shaoyao-source-name"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [작약](../herbs/white-peony.md) · 芍藥 | 6량 / 6량 | 계지의 두 배인 중량 관계. 리급·긴장의 완급축 |"},"skos:scopeNote":{"@value":"금궤요략 소건중탕. 비교표의 상한론 / 금궤 열 중 금궤요략 값을 선택: 芍藥 6량. 포제·제법의 표기: 계지의 두 배인 중량 관계. 리급·긴장의 완급축. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-shanghan--containsHerb--cinnamon-twig","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-twig"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [계지](../herbs/cinnamon-twig.md) · 桂枝 | 3량 / 3량 | 두 수록형 모두 거피 표기. 영위·온통의 축 |"},"skos:scopeNote":{"@value":"상한론 송본 소건중탕. 비교표의 상한론 / 금궤 열 중 상한론 송본 값을 선택: 桂枝 3량. 포제·제법의 표기: 두 수록형 모두 거피 표기. 영위·온통의 축. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-shanghan--containsHerb--fresh-ginger","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [생강](../herbs/fresh-ginger.md) · 生薑 | 3량 / 3량 | 상한론은 切 표기. 위기·영위의 조화 |"},"skos:scopeNote":{"@value":"상한론 송본 소건중탕. 비교표의 상한론 / 금궤 열 중 상한론 송본 값을 선택: 生薑 3량. 포제·제법의 표기: 상한론은 切 표기. 위기·영위의 조화. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-shanghan--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | **20매 / 12매** | 상한론은 擘 표기. 중초·영위 조화 |"},"skos:scopeNote":{"@value":"상한론 송본 소건중탕. 비교표의 상한론 / 금궤 열 중 상한론 송본 값을 선택: 大棗 20매. 포제·제법의 표기: 상한론은 擘 표기. 중초·영위 조화. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-shanghan--containsHerb--licorice","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [감초](../herbs/licorice.md) · 甘草 | **2량 / 3량** | 두 수록형 모두 炙 표기. 작약과 완급·조화 |"},"skos:scopeNote":{"@value":"상한론 송본 소건중탕. 비교표의 상한론 / 금궤 열 중 상한론 송본 값을 선택: 甘草 2량. 포제·제법의 표기: 두 수록형 모두 炙 표기. 작약과 완급·조화. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-shanghan--containsHerb--maltose","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maltose"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [교이](../herbs/maltose.md) · 膠飴 | 1승 / 1승 | 거재 뒤 녹임. 감온·건중·완급 |"},"skos:scopeNote":{"@value":"상한론 송본 소건중탕. 비교표의 상한론 / 금궤 열 중 상한론 송본 값을 선택: 膠飴 1승. 포제·제법의 표기: 거재 뒤 녹임. 감온·건중·완급. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-shanghan--containsHerb--shaoyao-source-name","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shaoyao-source-name"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [작약](../herbs/white-peony.md) · 芍藥 | 6량 / 6량 | 계지의 두 배인 중량 관계. 리급·긴장의 완급축 |"},"skos:scopeNote":{"@value":"상한론 송본 소건중탕. 비교표의 상한론 / 금궤 열 중 상한론 송본 값을 선택: 芍藥 6량. 포제·제법의 표기: 계지의 두 배인 중량 관계. 리급·긴장의 완급축. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-shanghan--sharesNameWith--xiaojianzhong-jinkui","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"rdf:predicate":{"@id":"km:sharesNameWith"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"위 인용은 공개 송본의 기록입니다. [금궤요략 6.13의 소건중탕 처방문](../classics/jinkui-yaolue/chapters/blood-bi-deficiency.md#clause-06-013)에는 감초 3량과 대조 12매가 적혀 있습니다. 이어지는 [6.14](../classics/jinkui-yaolue/chapters/blood-bi-deficiency.md#clause-06-014)는 소건중탕에 황기 1량 반을 더하고 나머지는 앞의 방법을 따른다고 설명합니다. 따라서 [황기건중탕의 구성표](huangqi-jianzhong-tang.md#source-dose-original)는 이 **금궤 수록형을 바탕으로 연결한 것**이며, 상한론의 감초·대조 수량을 끼워 넣지 않습니다."},"skos:scopeNote":{"@value":"소건중탕의 상한론 송본 감초 2량·대조 20매와 금궤요략 감초 3량·대조 12매를 각각 보존한다. 황기건중탕은 금궤 수록형을 바탕으로 별도 연결한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소건중탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["소건중탕","小建中湯"],"skos:definition":{"@value":"금궤요략의 소건중탕 6미 구성. 감초·대조의 수록량과 교이를 나중에 녹이는 제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소건중탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["소건중탕","小建中湯"],"skos:definition":{"@value":"상한론 송본의 소건중탕 6미 구성. 감초·대조의 수록량과 교이를 나중에 녹이는 제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
