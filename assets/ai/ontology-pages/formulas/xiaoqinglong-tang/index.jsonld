{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#asarum","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"세신","@language":"ko"},"skos:altLabel":["細辛"],"skos:definition":{"@value":"처방의 세신 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/asarum/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-twig","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"계지","@language":"ko"},"skos:altLabel":["桂枝"],"skos:definition":{"@value":"처방의 계지 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cinnamon-twig/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#dried-ginger","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"건강","@language":"ko"},"skos:altLabel":["乾薑"],"skos:definition":{"@value":"처방의 건강 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/dried-ginger/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ephedra","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"마황","@language":"ko"},"skos:altLabel":["麻黃"],"skos:definition":{"@value":"처방의 마황 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/ephedra/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하","@language":"ko"},"skos:altLabel":["半夏"],"skos:definition":{"@value":"반하의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#schisandra","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"오미자","@language":"ko"},"skos:altLabel":["北五味","五味子"],"skos:definition":{"@value":"처방의 오미자 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/schisandra/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shanghan-040","@type":["skos:Concept","km:ClassicalPassage"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"상한론 제40조 조문","@language":"ko"},"skos:altLabel":["상한론 제40조"],"skos:definition":{"@value":"상한론 제40조에서 소청룡탕의 처방명을 명시한 고전 조문. 앞뒤 증후와 제시 순서를 함께 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/classics/shanghanlun/clauses/taiyang-middle/#clause-040"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shaoyao-source-name","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"작약","@language":"ko"},"skos:altLabel":["芍藥"],"skos:definition":{"@value":"처방의 작약 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/white-peony/#processing"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shanghan-040--recordsFormula--xiaoqinglong-shanghan","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shanghan-040"},"rdf:predicate":{"@id":"km:recordsFormula"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/classics/shanghanlun/clauses/taiyang-middle/#clause-040"},"dcterms:description":{"@value":"\u003e 傷寒表不解，心下有水氣，乾嘔，發熱而欬，或渴，或利，或噎，或小便不利，少腹滿，或喘者，小青龍湯主之。"},"skos:scopeNote":{"@value":"小青龍湯을 명시한 조문과 기본 8미 수록형을 연결한다. 或로 열거한 동반 증후와 방후 가감을 기본 성분에 합치지 않는다. 관계는 문헌 수록과 출처를 나타낸다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--asarum","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#asarum"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [세신](../herbs/asarum.md) · 細辛 | 3량 | 별도 포제 표기 없음 | 산한·통규·온폐의 방향을 맡음 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 細辛, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--cinnamon-twig","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-twig"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [계지](../herbs/cinnamon-twig.md) · 桂枝 | 3량 | 껍질 제거 | 영위·양기의 소통과 온경을 맡음 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 桂枝, 수록량 3량, 포제 껍질 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--dried-ginger","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#dried-ginger"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [건강](../herbs/dried-ginger.md) · 乾薑 | 3량 | 별도 포제 표기 없음 | 중초의 허한을 덥히는 온중축 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 乾薑, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--ephedra","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ephedra"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [마황](../herbs/ephedra.md) · 麻黃 | 3량 | 마디 제거 | 표를 열고 폐기를 펼치는 선폐축 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 麻黃, 수록량 3량, 포제 마디 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--licorice","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [감초](../herbs/licorice.md) · 甘草 | 3량 | 자(굽거나 볶음) | 중초를 돕고 완급·배합 조화를 맡음 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 甘草, 수록량 3량, 포제 자(굽거나 볶음). 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 반승 | 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 반승, 포제 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--schisandra","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#schisandra"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [오미자](../herbs/schisandra.md) · 五味子 | 반승 | 별도 포제 표기 없음 | 폐기와 진액의 소모를 거두는 수렴축 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 五味子, 수록량 반승, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--shaoyao-source-name","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shaoyao-source-name"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [작약](../herbs/white-peony.md) · 芍藥 | 3량 | 별도 포제 표기 없음 | 영혈을 조화하고 긴장·리급을 완화하는 축 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 芍藥, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다. 원문은 芍藥으로 기록하며 백작약·적작약의 실제 원료 구분은 해당 수록본과 제제에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소청룡탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["소청룡탕","小靑龍湯","小青龍湯"],"skos:definition":{"@value":"상한론 송본의 소청룡탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
