{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"보화환 — 단계심법 7미 수록형","@language":"ko"},"skos:altLabel":["보화환","保和丸"],"skos:definition":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"진피","@language":"ko"},"skos:altLabel":["陳皮"],"skos:definition":{"@value":"진피의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-peel/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#digest-food-harmonize-stomach","@type":["skos:Concept","km:TreatmentPrinciple"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소식화적·화위","@language":"ko"},"skos:altLabel":["消食化積·和胃"],"skos:definition":{"@value":"식적에서 음식 정체와 동반 담습·기역·울열을 함께 살피는 전통 치법.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#traditional-pattern-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#food-stagnation","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"식적","@language":"ko"},"skos:altLabel":["食積"],"skos:definition":{"@value":"음식 정체와 식후팽만·트림·신물·배변 변화의 조합을 살피는 전통 변증 맥락.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/differentials/phlegm-vs-food-stagnation/#formula-pairings"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#forsythia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"연교","@language":"ko"},"skos:altLabel":["連翹"],"skos:definition":{"@value":"연교의 열매. 청열해독·소종산결·소산풍열과 처방별 실제 배합을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/forsythia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#hawthorn","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"산사","@language":"ko"},"skos:altLabel":["山楂","山楂肉"],"skos:definition":{"@value":"산사나무류의 성숙한 열매. 산사육 등 약용부위·가공과 소식화적 배합의 실제 비율을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/hawthorn/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#massa-medicata-fermentata","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신곡","@language":"ko"},"skos:altLabel":["神麯"],"skos:definition":{"@value":"곡물·식물성 원료를 배합해 발효한 신곡·신국. 원료·발효·볶음 가공과 소식화중 배합을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/massa-medicata-fermentata/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하","@language":"ko"},"skos:altLabel":["半夏"],"skos:definition":{"@value":"반하의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"복령","@language":"ko"},"skos:altLabel":["茯苓"],"skos:definition":{"@value":"복령의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/poria/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#raphanus-seed","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"나복자","@language":"ko"},"skos:altLabel":["蘿蔔子","萊菔子","내복자"],"skos:definition":{"@value":"무의 성숙한 씨. 蘿蔔子·萊菔子 표기와 소식제창·강기화담의 배합 및 생품·포제품을 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/raphanus-seed/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 1량 | 별도 포제 표기 없음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--containsHerb--forsythia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#forsythia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"},"dcterms:description":{"@value":"| [연교](../herbs/forsythia.md) · 連翹 | 1량 | 별도 포제 표기 없음 | 청열·산결로 울열을 풀어 줌 |"},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--containsHerb--hawthorn","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#hawthorn"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"},"dcterms:description":{"@value":"| [산사](../herbs/hawthorn.md) · 山楂 | 6량 | 별도 포제 표기 없음 | 음식의 적체를 소화하는 소식축 |"},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--containsHerb--massa-medicata-fermentata","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#massa-medicata-fermentata"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"},"dcterms:description":{"@value":"| [신곡](../herbs/massa-medicata-fermentata.md) · 神麯 | 2량 | 별도 포제 표기 없음 | 발효 약재로 식적·소화 정체를 다룸 |"},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 3량 | 별도 포제 표기 없음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 3량 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--containsHerb--raphanus-seed","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#raphanus-seed"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"},"dcterms:description":{"@value":"| [나복자](../herbs/raphanus-seed.md) · 蘿蔔子 | 1량 | 별도 포제 표기 없음 | 소식·강기로 음식 정체와 담을 함께 조절 |"},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--hasTraditionalPatternContext--food-stagnation","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#food-stagnation"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#traditional-pattern-care"},"dcterms:description":{"@value":"이 《단계심법》 기본 7미 수록형은 **식적**의 전통 변증·배합 맥락에서 비교합니다."},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다. 원전 주치와 후대 변증·배합 설명을 구분하고 동반 증후·원인 평가·섭취·기력·배변 경과를 함께 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-food-stagnation--hasTraditionalTreatmentPrinciple--digest-food-harmonize-stomach","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#food-stagnation"},"rdf:predicate":{"@id":"km:hasTraditionalTreatmentPrinciple"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#digest-food-harmonize-stomach"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#traditional-pattern-care"},"dcterms:description":{"@value":"식적에서 이 배합을 설명하는 전통 치법은 **소식화적·화위(消食化積·和胃)**입니다."},"skos:scopeNote":{"@value":"해당 수록형의 후대 변증·배합 해설. 식적·담습과 평소 허약을 비교하고 소식·화담·건비·이기의 비중을 동반 증후에 맞춰 확인한다. 원문 제법과 현대 제제·연구 조건은 각각 확인한다.","@language":"ko"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
