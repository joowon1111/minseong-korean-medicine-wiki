oaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/fresh-ginger/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"대조","@language":"ko"},"skos:altLabel":["大棗"],"skos:definition":{"@value":"대조의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/jujube-fruit/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하","@language":"ko"},"skos:altLabel":["半夏"],"skos:definition":{"@value":"반하의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"복령","@language":"ko"},"skos:altLabel":["茯苓"],"skos:definition":{"@value":"복령의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/poria/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--bamboo-shavings","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bamboo-shavings"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [죽여](../herbs/bamboo-shavings.md) · 竹茹 | 2량 | 별도 포제 표기 없음 | 담열·위기상역과 번조를 조절 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 竹茹, 수록량 2량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--citrus-immature","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-immature"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [지실](../herbs/citrus-immature.md) · 枳實 | 2량 | 밀기울로 볶음·속살 제거 | 기체·비만·담적을 내려 풀어 주는 축 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 枳實, 수록량 2량, 포제 밀기울로 볶음·속살 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 3량 | 별도 포제 표기 없음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 陳皮, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--fresh-ginger","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#preparation-and-dose"},"dcterms:description":{"@value":"| 전탕·복용 | 물 一盞半, 생강 五片, 대추 一枚를 더해 煎七分, 거재 후 식전에 복용 |"},"skos:scopeNote":{"@value":"삼인방 온담탕의 전탕 추가 재료. 기본 6미를 조말로 준비해 每服四大錢을 취하고 생강 五片·대추 一枚를 더하는 기록.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#preparation-and-dose"},"dcterms:description":{"@value":"| 전탕·복용 | 물 一盞半, 생강 五片, 대추 一枚를 더해 煎七分, 거재 후 식전에 복용 |"},"skos:scopeNote":{"@value":"삼인방 온담탕의 전탕 추가 재료. 기본 6미를 조말로 준비해 每服四大錢을 취하고 생강 五片·대추 一枚를 더하는 기록.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--licorice","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [감초](../herbs/licorice.md) · 甘草 | 1량 | 자(굽거나 볶음) | 중초를 돕고 완급·배합 조화를 맡음 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 甘草, 수록량 1량, 포제 자(굽거나 볶음). 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 2량 | 뜨거운 물로 7회 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 2량, 포제 뜨거운 물로 7회 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 1량반 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 茯苓, 수록량 1량반, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"온담탕 — 삼인극일병증방론 수록형","@language":"ko"},"skos:altLabel":["온담탕","溫膽湯"],"skos:definition":{"@value":"삼인극일병증방론의 온담탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
