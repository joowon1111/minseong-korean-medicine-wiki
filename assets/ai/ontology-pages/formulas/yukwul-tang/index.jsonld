{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#amomum","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"사인","@language":"ko"},"skos:altLabel":["砂仁"],"skos:definition":{"@value":"처방의 사인 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/amomum/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#atractylodes-lancea","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"창출","@language":"ko"},"skos:altLabel":["蒼朮"],"skos:definition":{"@value":"처방의 창출 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/atractylodes-lancea/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#beimu-source-name","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"패모","@language":"ko"},"skos:altLabel":["貝母"],"skos:definition":{"@value":"고전 원문 貝母라는 약명. 기원종 미기재를 보존하고 천패모·절패모의 구체 원료와 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/fritillaria/#source-name-beimu"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"천궁","@language":"ko"},"skos:altLabel":["芎藭"],"skos:definition":{"@value":"천궁의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/chuanxiong/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-aurantium-immature","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"지각","@language":"ko"},"skos:altLabel":["枳殼"],"skos:definition":{"@value":"지각 원료의 열매. 지실·진피와 기원·채취 단계·약용 부위를 구분하고 이기·관중·행체의 배합을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-aurantium-immature/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"진피","@language":"ko"},"skos:altLabel":["陳皮"],"skos:definition":{"@value":"진피의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-peel/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cyperus","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"향부자","@language":"ko"},"skos:altLabel":["香附"],"skos:definition":{"@value":"향부자 Cyperus rotundus의 뿌리줄기. 소간해울·이기관중·조경지통과 생품·초제품을 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cyperus/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#forsythia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"연교","@language":"ko"},"skos:altLabel":["連翹"],"skos:definition":{"@value":"연교의 열매. 청열해독·소종산결·소산풍열과 처방별 실제 배합을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/forsythia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"생강","@language":"ko"},"skos:altLabel":["生薑"],"skos:definition":{"@value":"생강의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/fresh-ginger/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gardenia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"치자","@language":"ko"},"skos:altLabel":["梔子"],"skos:definition":{"@value":"처방의 치자 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/gardenia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-donguibogam-uigam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육울탕 — 동의보감 의감 인용 12미 수록형","@language":"ko"},"skos:altLabel":["육울탕","六鬱湯"],"skos:definition":{"@value":"동의보감 잡병편 적취의 醫鑑 인용 12미형과 생강. 향부자·창출·신곡·치자·연교·陳皮·천궁·적복령·貝母·지각·자소엽 각 一錢, 감초 五分, 생강 三片 전탕 추가. 便香附는 가공 표기를 보존하며 세부 공정은 해당 대목 미기재다. 神塂·赤茯巔은 전사 표기로 원문에 유지한다. 貝母는 기원종을 확정하지 않는다. 剉作一貼·水煎服을 보존하고 DB 秦皮 연결 및 현대 g 환산값을 이 고전의 기록과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#donguibogam-uigam-version"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-yixuerumen","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육울탕 — 의학입문 9미 수록형","@language":"ko"},"skos:altLabel":["육울탕","六鬱湯"],"skos:definition":{"@value":"의학입문 郁類의 기본 9미. 진피·반하·천궁·창출 각 一錢, 적복령·산치자인 각 七分, 향부 二錢, 사인·감초 각 五分. 생강 三片은 별도 전탕 추가재료. 水煎服·隨證加減을 보존하고 개별 포제 미기재를 다른 수록형에서 채워 넣지 않는다. 동의보감 의감 인용 12미형 및 DB 환산량과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#massa-medicata-fermentata","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신곡","@language":"ko"},"skos:altLabel":["神麯"],"skos:definition":{"@value":"곡물·식물성 원료를 배합해 발효한 신곡·신국. 원료·발효·볶음 가공과 소식화중 배합을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/massa-medicata-fermentata/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#move-qi-release-stagnation","@type":["skos:Concept","km:TreatmentPrinciple"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"행기해울","@language":"ko"},"skos:altLabel":["行氣解鬱"],"skos:definition":{"@value":"육울의 기체를 소통시키고 동반 담·습·열·식·혈분의 배합을 조절하는 전통 치법.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#traditional-pattern-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#perilla-leaf","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"자소엽","@language":"ko"},"skos:altLabel":["紫蘇葉","乾蘇葉"],"skos:definition":{"@value":"차조기의 말린 잎을 사용하는 본초 개념. 자소자·자소경과 약용 부위를 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/perilla-leaf/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하","@language":"ko"},"skos:altLabel":["半夏"],"skos:definition":{"@value":"반하의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#red-poria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"적복령","@language":"ko"},"skos:altLabel":["赤茯苓"],"skos:definition":{"@value":"처방에 赤茯苓으로 기록된 복령 약재의 명칭. 복령·백복령·복신 표기와 약용 부위를 구분해 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/poria/#red-poria-in-formulas"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#six-stagnations","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육울","@language":"ko"},"skos:altLabel":["六鬱","六郁"],"skos:definition":{"@value":"기·혈·습·화·담·식의 여러 울체가 얽힌 상태를 살피는 전통 변증 맥락. 현대 우울장애 진단과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#traditional-pattern-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuyu-donguibogam-uigam--containsHerb--atractylodes-lancea","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-donguibogam-uigam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#atractylodes-lancea"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#donguibogam-uigam-version"},"dcterms:description":{"@value":"| [창출](../herbs/atractylodes-lancea.md) · 蒼朮 | 一錢 |"},"skos:scopeNote":{"@value":"동의보감 잡병편 적취의 醫鑑 인용 12미형과 생강. 향부자·창출·신곡·치자·연교·陳皮·천궁·적복령·貝母·지각·자소엽 각 一錢, 감초 五分, 생강 三片 전탕 추가. 便香附는 가공 표기를 보존하며 세부 공정은 해당 대목 미기재다. 神塂·赤茯巔은 전사 표기로 원문에 유지한다. 貝母는 기원종을 확정하지 않는다. 剉作一貼·水煎服을 보존하고 DB 秦皮 연결 및 현대 g 환산값을 이 고전의 기록과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuyu-donguibogam-uigam--containsHerb--beimu-source-name","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-donguibogam-uigam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#beimu-source-name"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#donguibogam-uigam-version"},"dcterms:description":{"@value":"| [패모](../herbs/fritillaria.md#source-name-beimu) · 貝母 | 一錢·기원종은 이 대목에 미기재 |"},"skos:scopeNote":{"@value":"동의보감 잡병편 적취의 醫鑑 인용 12미형과 생강. 향부자·창출·신곡·치자·연교·陳皮·천궁·적복령·貝母·지각·자소엽 각 一錢, 감초 五分, 생강 三片 전탕 추가. 便香附는 가공 표기를 보존하며 세부 공정은 해당 대목 미기재다. 神塂·赤茯巔은 전사 표기로 원문에 유지한다. 貝母는 기원종을 확정하지 않는다. 剉作一貼·水煎服을 보존하고 DB 秦皮 연결 및 현대 g 환산값을 이 고전의 기록과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuyu-donguibogam-uigam--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-donguibogam-uigam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#donguibogam-uigam-version"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 一錢 |"},"skos:scopeNote":{"@value":"동의보감 잡병편 적취의 醫鑑 인용 12미형