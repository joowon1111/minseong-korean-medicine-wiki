{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#achyranthes","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"우슬","@language":"ko"},"skos:altLabel":["牛膝"],"skos:definition":{"@value":"처방의 우슬 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/achyranthes/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"당귀","@language":"ko"},"skos:altLabel":["當歸"],"skos:definition":{"@value":"처방의 당귀 약미와 본초 문서를 연결하는 개념. 기원종과 수록본의 원문 약명을 각 출처에서 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/angelica/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica-pubescens","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"독활","@language":"ko"},"skos:altLabel":["獨活"],"skos:definition":{"@value":"처방의 독활 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/angelica-pubescens/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#asarum","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"세신","@language":"ko"},"skos:altLabel":["細辛"],"skos:definition":{"@value":"처방의 세신 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/asarum/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"천궁","@language":"ko"},"skos:altLabel":["芎藭"],"skos:definition":{"@value":"천궁의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/chuanxiong/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-heart","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"계심","@language":"ko"},"skos:altLabel":["桂心"],"skos:definition":{"@value":"처방에 桂心으로 기록된 약재 개념. 원문 명칭과 실제 원료의 기원·약용 부위·포제를 함께 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cinnamon-bark/#gyesim-source-name"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#dried-rehmannia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"건지황","@language":"ko"},"skos:altLabel":["乾地黃"],"skos:definition":{"@value":"처방의 건지황 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/rehmannia-root-fresh/#processing"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#duhuo-jisheng-qianjin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"독활기생탕 — 비급천금요방 수록형","@language":"ko"},"skos:altLabel":["독활기생탕","獨活寄生湯"],"skos:definition":{"@value":"비급천금요방의 독활기생탕 수록형. 해당 구성표의 15개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/duhuo-jisheng-tang/#source-dose-original"}},{"@id":"https://w