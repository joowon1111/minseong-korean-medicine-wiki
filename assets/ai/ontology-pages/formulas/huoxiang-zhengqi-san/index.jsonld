{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#agastache","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"곽향","@language":"ko"},"skos:altLabel":["藿香"],"skos:definition":{"@value":"처방의 곽향 약미와 본초 문서를 연결하는 개념. 원문 약명·가공·약용 부위와 조제 조건을 각 수록본에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/agastache/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica-dahurica","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"백지","@language":"ko"},"skos:altLabel":["白芷"],"skos:definition":{"@value":"처방의 백지 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/angelica-dahurica/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#areca-pericarp","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"대복피","@language":"ko"},"skos:altLabel":["大腹皮"],"skos:definition":{"@value":"처방의 대복피 약미와 본초 문서를 연결하는 개념. 원문 약명·가공·약용 부위와 조제 조건을 각 수록본에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/areca-pericarp/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#atractylodes","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"백출","@language":"ko"},"skos:altLabel":["白朮"],"skos:definition":{"@value":"백출의 기원·약용 부위·가공과 배합을 확