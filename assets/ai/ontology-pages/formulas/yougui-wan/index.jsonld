{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#aconite","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"부자","@language":"ko"},"skos:altLabel":["附子"],"skos:definition":{"@value":"처방의 부자 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/aconite/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"당귀","@language":"ko"},"skos:altLabel":["當歸"],"skos:definition":{"@value":"처방의 당귀 약미와 본초 문서를 연결하는 개념. 기원종과 수록본의 원문 약명을 각 출처에서 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/angelica/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-bark","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육계","@language":"ko"},"skos:altLabel":["肉桂"],"skos:definition":{"@value":"처방의 육계 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cinnamon-bark/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cornus-fruit","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"산수유","@language":"ko"},"skos:altLabel":["山茱萸"],"skos:definition":{"@value":"산수유의 기원·약용 과육·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cornus-fructus/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cuscuta-seed","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"토사자","@language":"ko"},"skos:altLabel":["菟絲子"],"skos:definition":{"@value":"토사자의 종자를 약용하는 본초 개념. 제(製)·초 등 처방의 가공 지시와 실제 원료를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cuscuta-seed/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#deer-antler-gelatin","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"녹각교","@language":"ko"},"skos:altLabel":["鹿角膠","鹿膠"],"skos:definition":{"@value":"골질화된 녹각을 달여 얻은 교질. 어린 뿔인 녹용과 구분하고 원문의 鹿膠·鹿角膠 및 초주 기록을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/deer-antler-gelatin/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#dioscorea","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"산약","@language":"ko"},"skos:altLabel":["乾山藥","山藥"],"skos:definition":{"@value":"처방의 산약 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/dioscorea/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#eucommia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"두충","@language":"ko"},"skos:altLabel":["杜仲"],"skos:definition":{"@value":"처방의 두충 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/eucommia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yang-deficiency","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신양허","@language":"ko"},"skos:altLabel":["腎陽虛"],"skos:definition":{"@value":"요슬의 시림·무력과 냉감·배뇨·부종·배변의 변화를 함께 살피는 전통 변증. 신장 여과기능 검사와는 별도로 평가한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/differentials/kidney-yin-vs-yang/#_4"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"숙지황","@language":"ko"},"skos:altLabel":["熟乾地黃","熟地黃","地黃"],"skos:definition":{"@value":"처방의 숙지황 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/prepared-rehmannia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--aconite","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#aconite"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [부자](../herbs/aconite.md) · 製附子 | 2량 | 법제 부자 | 법제를 전제로 온양·산한을 맡음 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 製附子, 수록량 2량, 포제 법제 부자. 역사적 제조 배합이며 현대 제제·1일량과 구분한다. 원문 自二兩，漸可加至五、六兩의 조절 기록을 보존한다. 실제 사용은 법제·규격·제형·용량·전탕·병용약을 확인하며 역사적 제조량을 현대 1일량으로 환산하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--angelica","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [당귀](../herbs/angelica.md) · 當歸 | 3량 | 별도 포제 표기 없음 | 혈을 기르면서 혈행을 조절 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 當歸, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 제조 배합이며 현대 제제·1일량과 구분한다. 원문 便溏勿用의 사용 조건을 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--cinnamon-bark","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-bark"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [육계](../herbs/cinnamon-bark.md) · 肉桂 | 2량 | 별도 포제 표기 없음 | 허한을 덥히고 온통의 방향을 더함 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 肉桂, 수록량 2량, 포제 별도 포제 표기 없음. 역사적 제조 배합이며 현대 제제·1일량과 구분한다. 원문 二兩，漸可加至四兩의 조절 기록은 역사적 제조 배합량이며 현대의 임의 증량 안내와 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--cornus-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cornus-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [산수유](../herbs/cornus-fructus.md) · 山茱萸 | 3량 | 가볍게 볶음 | 간신의 정혈을 돕고 수렴 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 山茱萸, 수록량 3량, 포제 가볍게 볶음. 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--cuscuta-seed","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cuscuta-seed"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [토사자](../herbs/cuscuta-seed.md) · 菟絲子 | 4량 | 법제 | 간신·정기를 보하고 고삽축을 맡음 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 菟絲子, 수록량 4량, 포제 법제. 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--deer-antler-gelatin","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#deer-antler-gelatin"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [녹각교](../herbs/deer-antler-gelatin.md) · 鹿角膠 | 4량 | 초주(炒珠: 교질 약재를 구슬 모양으로 볶음) | 정혈·근골을 받치는 온보축 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 鹿角膠, 수록량 4량, 포제 초주(炒珠: 교질 약재를 구슬 모양으로 볶음). 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--dioscorea","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#dioscorea"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [산약](../herbs/dioscorea.md) · 山藥 | 4량 | 초(볶음) | 비신을 보하고 보익약의 소화 기반을 받침 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 山藥, 수록량 4량, 포제 초(볶음). 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--eucommia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#eucommia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [두충](../herbs/eucommia.md) · 杜仲 | 4량 | 생강탕으로 볶음 | 간신·근골을 받치는 보익축 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 杜仲, 수록량 4량, 포제 생강탕으로 볶음. 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 大懷熟 | 8량 | 별도 포제 표기 없음 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 大懷熟, 수록량 8량, 포제 별도 포제 표기 없음. 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--wolfberry-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wolfberry-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [구기자](../herbs/cornus-extra.md) · 枸杞 | 4량 | 가볍게 볶음 | 간신의 음혈과 정을 받침 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 枸杞, 수록량 4량, 포제 가볍게 볶음. 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--hasTraditionalPatternContext--kidney-yang-deficiency","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yang-deficiency"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#original-pattern-course"},"dcterms:description":{"@value":"이 경악전서 우귀환 수록형은 냉감·요슬무력에 정혈부족이 겹친 [신양허](../diagnostics/differentials/kidney-yin-vs-yang.md#_4)의 변증·배합 맥락에서 비교합니다."},"skos:scopeNote":{"@value":"경악전서 우귀환 기본 10미의 보정·온양 맥락. 냉감·요슬무력에 정혈부족이 겹친 조건을 살피며 신기환의 수분 조절 배합과 구분한다. 당귀의 便溏勿用, 법제 부자·육계의 원문 조절 범위와 실제 조제·전탕·병용약을 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wolfberry-fruit","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"구기자","@language":"ko"},"skos:altLabel":["枸杞","枸杞子"],"skos:definition":{"@value":"성숙한 붉은 열매를 약용하는 구기자. 뿌리껍질 지골피와 원료·약용 부위를 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cornus-extra/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"우귀환 — 경악전서 수록형","@language":"ko"},"skos:altLabel":["우귀환","右歸丸"],"skos:definition":{"@value":"경악전서 보진의 정혈 보익 바탕에 육계·법제 부자를 배합한 기본 10미 환제. 당귀의 사용 조건과 원전 증량 범위를 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
