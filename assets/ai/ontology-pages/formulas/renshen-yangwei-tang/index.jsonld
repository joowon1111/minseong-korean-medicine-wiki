{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#agastache","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"곽향","@language":"ko"},"skos:altLabel":["藿香"],"skos:definition":{"@value":"처방의 곽향 약미와 본초 문서를 연결하는 개념. 원문 약명·가공·약용 부위와 조제 조건을 각 수록본에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/agastache/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#atractylodes-lancea","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"창출","@language":"ko"},"skos:altLabel":["蒼朮"],"skos:definition":{"@value":"처방의 창출 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/atractylodes-lancea/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-red-peel","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"귤홍","@language":"ko"},"skos:altLabel":["橘紅"],"skos:definition":{"@value":"처방의 귤홍 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-peel/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#external-wind-cold-internal-raw-cold","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"외감풍한·내상생랭","@language":"ko"},"skos:altLabel":[],"skos:definition":{"@value":"해당 원문 주치와 배합을 대조하는 전통 변증 맥락. 현재 한열·오심·팽만·섭취량과 경과를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangwei-tang/#traditional-pattern-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"생강","@language":"ko"},"skos:altLabel":["生薑"],"skos:definition":{"@value":"생강의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/fresh-ginger/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼","@language":"ko"},"skos:altLabel":["人參"],"skos:definition":{"@value":"인삼의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/ginseng/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#magnolia-bark","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"후박","@language":"ko"},"skos:altLabel":["厚朴"],"skos:definition":{"@value":"후박의 기원·약용 부위·가공과 배합을 확인하는 나무껍질 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/magnolia-bark/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#mume-fruit","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"오매","@language":"ko"},"skos:altLabel":["烏梅"],"skos:definition":{"@value":"처방의 오매 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/mume-fruit/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하","@language":"ko"},"skos:altLabel":["半夏"],"skos:definition":{"@value":"반하의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"복령","@language":"ko"},"skos:altLabel":["茯苓"],"skos:definition":{"@value":"복령의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/poria/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangwei-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양위탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양위탕","人參養胃湯","人蔘養胃湯"],"skos:definition":{"@value":"국방 淳祐新添方 인삼양위탕 기본 9미의 일괄 제조 배합. 半夏 湯洗七次·厚朴 去粗皮薑汁製·蒼朮 米泔浸一宿洗切炒 각 一兩, 藿香葉 洗去土·草果 去皮膜·茯苓 去黑皮·人參 각 半兩, 甘草 炙 二錢半, 橘紅 七錢半. 每服四錢·水一盞半·姜七片·烏梅一個·煎至六分·去滓熱服을 보존한다. 생강·오매는 매복 전탕 추가재료이며 대조는 이 수록형에 없다. 후대 방약합편의 진피·적복령·생강3편·대조2매와 구분하고 제조 총량을 현대 1일량으로 환산하지 않는다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangwei-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-external-wind-cold-internal-raw-cold--hasTraditionalTreatmentPrinciple--warm-middle-release-exterior-transform-damp","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#external-wind-cold-internal-raw-cold"},"rdf:predicate":{"@id":"km:hasTraditionalTreatmentPrinciple"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#warm-middle-release-exterior-transform-damp"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangwei-tang/#traditional-pattern-care"},"dcterms:description":{"@value":"이 배합의 전통 치법은 **온중해표·화습(溫中解表·化濕)**로 설명합니다."},"skos:scopeNote":{"@value":"원문의 주치와 실제 약미 배치에 대한 후대 치법 해설. 해당 수록형의 적용 맥락과 증상·식사·배변의 경과를 함께 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangwei-guofang--containsHerb--agastache","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangwei-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#agastache"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangwei-tang/#source-dose-original"},"dcterms:description":{"@value":"| [곽향엽](../herbs/agastache.md) · 藿香葉 | 半兩 | 洗去土·잎 표기 보존 |"},"skos:scopeNote":{"@value":"국방 淳祐新添方 인삼양위탕 기본 9미의 일괄 제조 배합. 半夏 湯洗七次·厚朴 去粗皮薑汁製·蒼朮 米泔浸一宿洗切炒 각 一兩, 藿香葉 洗去土·草果 去皮膜·茯苓 去黑皮·人參 각 半兩, 甘草 炙 二錢半, 橘紅 七錢半. 每服四錢·水一盞半·姜七片·烏梅一個·煎至六分·去滓熱服을 보존한다. 생강·오매는 매복 전탕 추가재료이며 대조는 이 수록형에 없다. 후대 방약합편의 진피·적복령·생강3편·대조2매와 구분하고 제조 총량을 현대 1일량으로 환산하지 않는다.","@language":"ko"}},{"@id