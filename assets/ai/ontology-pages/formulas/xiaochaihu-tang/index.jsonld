{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bupleurum","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"시호","@language":"ko"},"skos:altLabel":["柴胡"],"skos:definition":{"@value":"처방의 시호 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/bupleurum/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"생강","@language":"ko"},"skos:altLabel":["生薑"],"skos:definition":{"@value":"생강의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/fresh-ginger/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼","@language":"ko"},"skos:altLabel":["人參"],"skos:definition":{"@value":"인삼의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/ginseng/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"대조","@language":"ko"},"skos:altLabel":["大棗"],"skos:definition":{"@value":"대조의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/jujube-fruit/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하","@language":"ko"},"skos:altLabel":["半夏"],"skos:definition":{"@value":"반하의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scutellaria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"황금","@language":"ko"},"skos:altLabel":["黃芩"],"skos:definition":{"@value":"처방의 황금 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/scutellaria/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shanghan-096","@type":["skos:Concept","km:ClassicalPassage"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"상한론 제96조 조문","@language":"ko"},"skos:altLabel":["상한론 제96조"],"skos:definition":{"@value":"상한론 제96조에서 소시호탕의 처방명을 명시한 고전 조문. 앞뒤 증후와 제시 순서를 함께 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/classics/shanghanlun/clauses/taiyang-middle/#clause-096"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shanghan-100","@type":["skos:Concept","km:ClassicalPassage"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"상한론 제100조 조문","@language":"ko"},"skos:altLabel":["상한론 제100조"],"skos:definition":{"@value":"상한론 제100조에서 소건중탕·소시호탕의 처방명을 명시한 고전 조문. 앞뒤 증후와 제시 순서를 함께 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/classics/shanghanlun/clauses/taiyang-middle/#clause-100"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shanghan-096--recordsFormula--xiaochaihu-shanghan","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shanghan-096"},"rdf:predicate":{"@id":"km:recordsFormula"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/classics/shanghanlun/clauses/taiyang-middle/#clause-096"},"dcterms:description":{"@value":"\u003e 傷寒五六日，中風，往來寒熱，胸脇苦滿，嘿嘿不欲飲食，心煩喜嘔。或胸中煩而不嘔，或渴，或腹中痛，或脇下痞鞕，或心下悸、小便不利，或不渴、身有微熱，或欬者，小柴胡湯主之。"},"skos:scopeNote":{"@value":"小柴胡湯을 명시한 송본 조문과 해당 기본 7미 수록형을 연결한다. 여러 或 조건은 함께 읽는다. 관계는 문헌 수록과 출처를 나타낸다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shanghan-100--recordsFormula--xiaochaihu-shanghan","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shanghan-100"},"rdf:predicate":{"@id":"km:recordsFormula"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/classics/shanghanlun/clauses/taiyang-middle/#clause-100"},"dcterms:description":{"@value":"\u003e 傷寒，陽脈濇，陰脈弦，法當腹中急痛，先與小建中湯，不差者，與小柴胡湯主之。"},"skos:scopeNote":{"@value":"不差者，與小柴胡湯의 재평가 후 처방이다. 앞의 소건중탕과 치료 순서를 보존한다. 관계는 문헌 수록과 출처를 나타낸다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--bupleurum","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bupleurum"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [시호](../herbs/bupleurum.md) · 柴胡 | 반근 | 별도 포제 표기 없음 | 소양·간울의 기기 조절을 맡음 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 柴胡, 수록량 반근, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--fresh-ginger","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [생강](../herbs/fresh-ginger.md) · 生薑 | 3량 | 절편 | 위기를 조화하고 오심·상역을 조절 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 生薑, 수록량 3량, 포제 절편. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 3량 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 人參, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 12매 | 쪼갬 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 大棗, 수록량 12매, 포제 쪼갬. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--licorice","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [감초](../herbs/licorice.md) · 甘草 | 3량 | 자(굽거나 볶음) | 중초를 돕고 완급·배합 조화를 맡음 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 甘草, 수록량 3량, 포제 자(굽거나 볶음). 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 반승 | 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 반승, 포제 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--scutellaria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scutellaria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황금](../herbs/scutellaria.md) · 黃芩 | 3량 | 별도 포제 표기 없음 | 청열·조습으로 열과 습의 결합을 조절 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 黃芩, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소시호탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["소시호탕","小柴胡湯"],"skos:definition":{"@value":"상한론 송본의 소시호탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
