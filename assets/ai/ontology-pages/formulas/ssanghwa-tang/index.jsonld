{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"당귀","@language":"ko"},"skos:altLabel":["當歸"],"skos:definition":{"@value":"처방의 당귀 약미와 본초 문서를 연결하는 개념. 기원종과 수록본의 원문 약명을 각 출처에서 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/angelica/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"황기","@language":"ko"},"skos:altLabel":["黃耆","黃芪"],"skos:definition":{"@value":"처방의 황기 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/astragalus/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"천궁","@language":"ko"},"skos:altLabel":["芎藭"],"skos:definition":{"@value":"천궁의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/chuanxiong/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-bark","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육계","@language":"ko"},"skos:altLabel":["肉桂"],"skos:definition":{"@value":"처방의 육계 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/cinnamon-bark/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"숙지황","@language":"ko"},"skos:altLabel":["熟乾地黃","熟地黃","地黃"],"skos:definition":{"@value":"처방의 숙지황 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/prepared-rehmannia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"쌍화탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["쌍화탕","雙和湯"],"skos:definition":{"@value":"국방의 쌍화탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--angelica","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [당귀](../herbs/angelica.md) · 當歸 | 3량 | 씻음·술에 담금 | 혈을 기르면서 혈행을 조절 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 當歸, 수록량 3량, 포제 씻음·술에 담금. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 3량 | 꿀로 자제 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 黃耆, 수록량 3량, 포제 꿀로 자제. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 3량 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 川芎, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--cinnamon-bark","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#cinnamon-bark"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [육계](../herbs/cinnamon-bark.md) · 肉桂 | 2량2전반 | 껍질 제거·직접 불에 닿지 않음 | 허한을 덥히고 온통의 방향을 더함 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 肉桂, 수록량 2량2전반, 포제 껍질 제거·직접 불에 닿지 않음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--licorice","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [감초](../herbs/licorice.md) · 甘草 | 2량2전반 | 자(굽거나 볶음) | 중초를 돕고 완급·배합 조화를 맡음 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 甘草, 수록량 2량2전반, 포제 자(굽거나 볶음). 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 熟地黃 | 3량 | 깨끗이 씻음·술을 사용해 찜 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 熟地黃, 수록량 3량, 포제 깨끗이 씻음·술을 사용해 찜. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--white-peony","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-peony"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [백작약](../herbs/white-peony.md) · 白芍藥 | 7량반 | 별도 포제 표기 없음 | 양혈·유근·완급의 축을 맡음 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 白芍藥, 수록량 7량반, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-peony","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"백작약","@language":"ko"},"skos:altLabel":["白芍藥","白芍"],"skos:definition":{"@value":"처방의 백작약 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/white-peony/"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
