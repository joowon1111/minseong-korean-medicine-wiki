f:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-immature/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"진피","@language":"ko"},"skos:altLabel":["陳皮"],"skos:definition":{"@value":"진피의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-peel/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#fresh-ginger","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"생강","@language":"ko"},"skos:altLabel":["生薑"],"skos:definition":{"@value":"생강의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/fresh-ginger/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼","@language":"ko"},"skos:altLabel":["人參"],"skos:definition":{"@value":"인삼의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/ginseng/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#hawthorn","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"산사","@language":"ko"},"skos:altLabel":["山楂","山楂肉"],"skos:definition":{"@value":"산사나무류의 성숙한 열매. 산사육 등 약용부위·가공과 소식화적 배합의 실제 비율을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/hawthorn/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"대조","@language":"ko"},"skos:altLabel":["大棗"],"skos:definition":{"@value":"대조의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/jujube-fruit/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#magnolia-bark","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"후박","@language":"ko"},"skos:altLabel":["厚朴"],"skos:definition":{"@value":"후박의 기원·약용 부위·가공과 배합을 확인하는 나무껍질 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/magnolia-bark/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#massa-medicata-fermentata","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신곡","@language":"ko"},"skos:altLabel":["神麯"],"skos:definition":{"@value":"곡물·식물성 원료를 배합해 발효한 신곡·신국. 원료·발효·볶음 가공과 소식화중 배합을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/massa-medicata-fermentata/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#samchul-geonbi-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"삼출건비탕 — 동의보감 집략 인용 수록형","@language":"ko"},"skos:altLabel":["삼출건비탕","參朮健脾湯","蔘朮健脾湯"],"skos:definition":{"@value":"동의보감 잡병편 권4 내상 食傷補益之劑의 集略 인용 삼출건비탕 기본 12미와 전탕 생강·대조. 인삼·백출·白茯苓·후박·陳皮·山査肉 각 一錢, 枳實·白芍藥 각 八分, 神麴·麥芽·縮砂·甘草 각 五分. 剉作一貼·入薑三棗二水煎服 기록을 보존하고 제법 대조의 생강 3쪽·대조 2매를 전탕 추가재료로 구분한다. 해당 대목의 포제 미기재를 후대 처방으로 채우지 않는다. 지실을 뺀 2002년 해설서 B형 및 현대 DB g 환산량과 구분하며, 정전가미이진탕의 신곡·맥아면 별포·조입 조건을 가져오지 않는다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/samchul-geonbi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#spleen-stomach-qi-deficiency-with-food-stagnation","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"비위기허겸식적","@language":"ko"},"skos:altLabel":["脾胃氣虛兼食積"],"skos:definition":{"@value":"평소 입맛·섭취량·기력 저하에 식후 그득함·음식 정체가 동반되는 변증·배합 맥락. 식적 중심 및 비허담습의 오심·기체와 비교한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/samchul-geonbi-tang/#traditional-pattern-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-samchul-geonbi-donguibogam--containsHerb--amomum","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#samchul-geonbi-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#amomum"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/samchul-geonbi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [사인](../herbs/amomum.md) · 縮砂 | 五分 | 축사라는 원문 명칭 보존 |"},"skos:scopeNote":{"@value":"동의보감 잡병편 권4 내상 食傷補益之劑의 集略 인용 삼출건비탕 기본 12미와 전탕 생강·대조. 인삼·백출·白茯苓·후박·陳皮·山査肉 각 一錢, 枳實·白芍藥 각 八分, 神麴·麥芽·縮砂·甘草 각 五分. 剉作一貼·入薑三棗二水煎服 기록을 보존하고 제법 대조의 생강