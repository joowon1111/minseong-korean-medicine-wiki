anguage":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/atractylodes-lancea/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하백출천마탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["반하백출천마탕","半夏白朮天麻湯"],"skos:definition":{"@value":"비위론의 기본 13미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#barley-malt","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"맥아","@language":"ko"},"skos:altLabel":["麥芽"],"skos:definition":{"@value":"보리 열매를 발아·건조한 맥아. 소식건비의 배합과 생품·초품 및 수유 관련 조건을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/barley-malt/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"진피","@language":"ko"},"skos:altLabel":["陳皮"],"skos:definition":{"@value":"진피의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-peel/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#dried-ginger","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"건강","@language":"ko"},"skos:altLabel":["乾薑"],"skos:definition":{"@value":"처방의 건강 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/dried-ginger/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gastrodia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"천마","@language":"ko"},"skos:altLabel":["天麻"],"skos:definition":{"@value":"천마의 덩이줄기. 전통 식풍 배합과 풍담·간양의 동반 양상을 처방별로 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/gastrodia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼","@language":"ko"},"skos:altLabel":["人參"],"skos:definition":{"@value":"인삼의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/ginseng/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#massa-medicata-fermentata","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신곡","@language":"ko"},"skos:altLabel":["神麯"],"skos:definition":{"@value":"곡물·식물성 원료를 배합해 발효한 신곡·신국. 원료·발효·볶음 가공과 소식화중 배합을 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/massa-medicata-fermentata/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#phellodendron","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"황백","@language":"ko"},"skos:altLabel":["黃柏"],"skos:definition":{"@value":"처방의 황백 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/phellodendron/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하","@language":"ko"},"skos:altLabel":["半夏"],"skos:definition":{"@value":"반하의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#spleen-qi-deficiency-with-phlegm","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"비허담습","@language":"ko"},"skos:altLabel":["脾虛痰濕"],"skos:definition":{"@value":"피로·식욕저하·무른 변 등 비위허약에 오심·그득함 등 담습의 양상이 겹치는 변증.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/patterns/phlegm-fluid/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-baizhu-tianma-piwei--containsHerb--alisma","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#alisma"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"},"dcterms:description":{"@value":"| [택사](../herbs/alisma.md) · 澤瀉 | 5分 | 별도 포제 표기 없음 | 수습을 내려 정체를 조절 |"},"skos:scopeNote":{"@value":"비위론 13미 수록형. 황백 二分·주세, 건강 三分, 천마·창출·백복령·황기·택사·인삼 각 五分, 백출·炒曲 각 一錢, 반하 湯洗七次·대맥얼면·귤피 각 一錢五分. 매회 半兩을 물 二盞에서 一盞으로 달여 거재·열복·식전. 동의보감의 생강 5쪽 추가는 별도 수록형이며 이 기본 구성에 합치지 않는다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-baizhu-tianma-piwei--containsHerb--a