{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"당귀","@language":"ko"},"skos:altLabel":["當歸"],"skos:definition":{"@value":"처방의 당귀 약미와 본초 문서를 연결하는 개념. 기원종과 수록본의 원문 약명을 각 출처에서 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/angelica/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#atractylodes","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"백출","@language":"ko"},"skos:altLabel":["白朮"],"skos:definition":{"@value":"백출의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/atractylodes/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"팔진탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["팔진탕","八珍湯","팔물탕","八物湯"],"skos:definition":{"@value":"만병회춘의 팔진탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"천궁","@language":"ko"},"skos:altLabel":["芎藭"],"skos:definition":{"@value":"천궁의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/chuanxiong/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼","@language":"ko"},"skos:altLabel":["人參"],"skos:definition":{"@value":"인삼의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/ginseng/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"감초","@language":"ko"},"skos:altLabel":["甘草"],"skos:definition":{"@value":"감초의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/licorice/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"복령","@language":"ko"},"skos:altLabel":["茯苓"],"skos:definition":{"@value":"복령의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/poria/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"숙지황","@language":"ko"},"skos:altLabel":["熟乾地黃","熟地黃","地黃"],"skos:definition":{"@value":"처방의 숙지황 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/prepared-rehmannia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#qi-blood-deficiency","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"기혈양허","@language":"ko"},"skos:altLabel":["氣血兩虛"],"skos:definition":{"@value":"기허의 피로·무력감과 혈허의 창백·어지럼·건조·수면저하가 함께 나타나는 복합 허증. 식사·소화와 병후·산후의 회복 상태를 함께 살핀다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/patterns/qi-blood-deficiency/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--angelica","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#angelica"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [당귀](../herbs/angelica.md) · 當歸 | 1전 | 별도 포제 표기 없음 | 혈을 기르면서 혈행을 조절 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 當歸, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--atractylodes","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#atractylodes"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [백출](../herbs/atractylodes.md) · 白朮 | 1전 | 별도 포제 표기 없음 | 건비·조습으로 운화를 돕고 보기약을 보완 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 白朮, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 1전 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 川芎, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 1전 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 人參, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--licorice","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#licorice"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [감초](../herbs/licorice.md) · 甘草 | 5푼 | 자(굽거나 볶음) | 중초를 돕고 완급·배합 조화를 맡음 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 甘草, 수록량 5푼, 포제 자(굽거나 볶음). 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 1전 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 茯苓, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 熟地黃 | 1전 | 별도 포제 표기 없음 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 熟地黃, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--white-peony","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-peony"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [백작약](../herbs/white-peony.md) · 白芍 | 1전 | 별도 포제 표기 없음 | 양혈·유근·완급의 축을 맡음 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 白芍, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--hasTraditionalPatternContext--qi-blood-deficiency","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#qi-blood-deficiency"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"**해석·주치와 배합:** 기와 혈이 함께 부족한 허손을 다루는 팔진탕 수록형입니다."},"skos:scopeNote":{"@value":"만병회춘 팔진탕 수록형의 인삼·백출·복령·당귀·천궁·백작약·숙지황 각 1전과 자감초 五分의 기록을 보존한다. 기허와 혈허가 함께 나타나는 배합 맥락이며, 한국 팔물탕의 후대 수록량이나 의방고의 지황·작약 표기 및 수치와 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-peony","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"백작약","@language":"ko"},"skos:altLabel":["白芍藥","白芍"],"skos:definition":{"@value":"처방의 백작약 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/white-peony/"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
