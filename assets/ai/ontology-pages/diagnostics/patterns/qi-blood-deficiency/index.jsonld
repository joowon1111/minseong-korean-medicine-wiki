{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"팔진탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["팔진탕","八珍湯","팔물탕","八物湯"],"skos:definition":{"@value":"만병회춘의 팔진탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#qi-blood-deficiency","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"기혈양허","@language":"ko"},"skos:altLabel":["氣血兩虛"],"skos:definition":{"@value":"기허의 피로·무력감과 혈허의 창백·어지럼·건조·수면저하가 함께 나타나는 복합 허증. 식사·소화와 병후·산후의 회복 상태를 함께 살핀다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/patterns/qi-blood-deficiency/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"십전대보탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["십전대보탕","十全大補湯"],"skos:definition":{"@value":"국방의 십전대보탕 수록형. 해당 구성표의 10개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--hasTraditionalPatternContext--qi-blood-deficiency","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#qi-blood-deficiency"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"**해석·주치와 배합:** 기와 혈이 함께 부족한 허손을 다루는 팔진탕 수록형입니다."},"skos:scopeNote":{"@value":"만병회춘 팔진탕 수록형의 인삼·백출·복령·당귀·천궁·백작약·숙지황 각 1전과 자감초 五分의 기록을 보존한다. 기허와 혈허가 함께 나타나는 배합 맥락이며, 한국 팔물탕의 후대 수록량이나 의방고의 지황·작약 표기 및 수치와 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-qi-blood-deficiency--hasTraditionalTreatmentPrinciple--tonify-qi-and-blood","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#qi-blood-deficiency"},"rdf:predicate":{"@id":"km:hasTraditionalTreatmentPrinciple"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#tonify-qi-and-blood"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/blood-deficiency/#treatment-principle"},"dcterms:description":{"@value":"[기혈양허](../diagnostics/patterns/qi-blood-deficiency.md)의 기본 치법은 **기혈쌍보(氣血雙補)**입니다."},"skos:scopeNote":{"@value":"기허의 피로·식욕저하에 혈허의 창백·어지럼이 함께 나타나는 기혈양허의 전통 치법. 동반 냉감·소화 상태에 따라 보기와 보혈의 비중을 조절한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shiquan-guofang--hasTraditionalPatternContext--qi-blood-deficiency","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#qi-blood-deficiency"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#immune-metabolic-network"},"dcterms:description":{"@value":"기혈양허와 오래된 쇠약·회복 지연을 살피며, 열감·소화력·냉감·땀의 양상에 따라 다른 보익 처방과 비교합니다."},"skos:scopeNote":{"@value":"국방의 십미 등분 제조 배합과 전탕 시 생강·대조의 별기를 보존한다. 기혈양허에 냉감·허약이 겹칠 때 황기·육계의 보기·온보를 함께 비교하며, 열감·소화력·땀과 회복 상태를 살핀다. 외과이례 수록량·포제, 현대 탕제 및 시험 제제는 각각 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#tonify-qi-and-blood","@type":["skos:Concept","km:TreatmentPrinciple"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"기혈쌍보","@language":"ko"},"skos:altLabel":["氣血雙補"],"skos:definition":{"@value":"기혈양허에서 보기와 보혈을 함께 적용하는 전통 치법. 피로·식욕·안색·어지럼과 냉열·소화 상태에 따라 배합의 비중을 조절한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/blood-deficiency/#treatment-principle"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
