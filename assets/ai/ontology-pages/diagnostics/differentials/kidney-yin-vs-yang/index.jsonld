{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yang-deficiency","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신양허","@language":"ko"},"skos:altLabel":["腎陽虛"],"skos:definition":{"@value":"요슬의 시림·무력과 냉감·배뇨·부종·배변의 변화를 함께 살피는 전통 변증. 신장 여과기능 검사와는 별도로 평가한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/differentials/kidney-yin-vs-yang/#_4"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yin-deficiency","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신음허","@language":"ko"},"skos:altLabel":["腎陰虛"],"skos:definition":{"@value":"요슬무력과 함께 건조·도한·허열 등 음액·정혈 부족의 조합을 살피는 전통 변증. 식사·소화·수면과 현재의 질환 평가를 함께 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/differentials/kidney-yin-vs-yang/#_3"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuwei-xiaoer","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"지황환(육미지황환) — 소아약증직결 수록형","@language":"ko"},"skos:altLabel":["지황환","육미지황환","地黃丸","六味地黃丸"],"skos:definition":{"@value":"소아약증직결의 지황환·육미지황환 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liuwei-dihuang-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#nourish-kidney-yin","@type":["skos:Concept","km:TreatmentPrinciple"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"자보신음","@language":"ko"},"skos:altLabel":["滋補腎陰"],"skos:definition":{"@value":"신음허에서 음액·정혈을 보하는 전통 치법. 허열·수습·소화와 정혈 보충의 비중에 따라 배합을 비교한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/differentials/kidney-yin-vs-yang/#nourish-kidney-yin"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shenqi-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신기환·팔미신기환 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["신기환","팔미신기환","팔미지황환","腎氣丸","八味腎氣丸"],"skos:definition":{"@value":"금궤요략의 신기환·팔미신기환 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/bawei-dihuang-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-kidney-yang-deficiency--hasTraditionalTreatmentPrinciple--warm-kidney-yang","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yang-deficiency"},"rdf:predicate":{"@id":"km:hasTraditionalTreatmentPrinciple"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#warm-kidney-yang"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/diagnostics/differentials/kidney-yin-vs-yang/#warm-kidney-yang"},"dcterms:description":{"@value":"신양허의 기본 치법은 **온보신양(溫補腎陽)**입니다."},"skos:scopeNote":{"@value":"신양허의 냉감·요슬무력과 배뇨·부종·배변을 함께 살피는 전통 치법. 온양화기와 보정·근골 보충의 배합 차이, 부자의 규격·법제·실제량·전탕·병용약을 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-kidney-yin-deficiency--hasTraditionalTreatmentPrinciple--nourish-kidney-yin","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yin-deficiency"},"rdf:predicate":{"@id":"km:hasTraditionalTreatmentPrinciple"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#nourish-kidney-yin"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/diagnostics/differentials/kidney-yin-vs-yang/#nourish-kidney-yin"},"dcterms:description":{"@value":"신음허의 기본 치법은 **자보신음(滋補腎陰)**입니다."},"skos:scopeNote":{"@value":"신음허의 건조·도한·허열과 요슬무력을 함께 살피는 전통 치법. 허열·수습·소화 부담과 정혈 보충의 비중을 함께 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuwei-xiaoer--hasTraditionalPatternContext--kidney-yin-deficiency","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuwei-xiaoer"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yin-deficiency"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/liuwei-dihuang-wan/#pediatric-original-context"},"dcterms:description":{"@value":"이 소아 지황환 수록형은 [신음허](../diagnostics/differentials/kidney-yin-vs-yang.md#_3)의 후대 변증·배합 맥락에서 비교합니다."},"skos:scopeNote":{"@value":"소아약증직결의 숙지황 8전·산수유육과 산약 각 4전·택사와 목단피 및 백복령 각 3전 수록형을 후대 신음허의 변증·배합 해석과 연결한다. 소아 원문의 신겁·제법과 후대 성인 활용·현대 시험 제제를 구분하며, 건조·도한·허열과 요슬·소화 상태를 함께 살핀다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shenqi-jinkui--hasTraditionalPatternContext--kidney-yang-deficiency","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shenqi-jinkui"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yang-deficiency"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bawei-dihuang-wan/#jinkui-shenqi-version"},"dcterms:description":{"@value":"이 금궤 수록형은 냉감·요슬무력·배뇨 변화가 동반되는 [신양허](../diagnostics/differentials/kidney-yin-vs-yang.md#_4)의 후대 변증·배합 맥락에서 비교합니다."},"skos:scopeNote":{"@value":"금궤요략의 건지황·계지·포부자 원전 수록형을 신양허의 후대 변증·온양화기 해석과 연결한다. 허로·하복부·소변의 원전 주치와 냉감·요슬무력·배뇨의 현재 평가를 구분하며, 후대 숙지황·육계형 및 현대 제제를 각각 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--hasTraditionalPatternContext--kidney-yang-deficiency","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yang-deficiency"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#original-pattern-course"},"dcterms:description":{"@value":"이 경악전서 우귀환 수록형은 냉감·요슬무력에 정혈부족이 겹친 [신양허](../diagnostics/differentials/kidney-yin-vs-yang.md#_4)의 변증·배합 맥락에서 비교합니다."},"skos:scopeNote":{"@value":"경악전서 우귀환 기본 10미의 보정·온양 맥락. 냉감·요슬무력에 정혈부족이 겹친 조건을 살피며 신기환의 수분 조절 배합과 구분한다. 당귀의 便溏勿用, 법제 부자·육계의 원문 조절 범위와 실제 조제·전탕·병용약을 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-zuogui-jingyue--hasTraditionalPatternContext--kidney-yin-deficiency","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#zuogui-jingyue"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#kidney-yin-deficiency"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/zuogui-wan/#original-pattern-course"},"dcterms:description":{"@value":"이 경악전서 좌귀환 수록형은 진음·정혈의 부족을 함께 살피는 [신음허](../diagnostics/differentials/kidney-yin-vs-yang.md#_3)의 변증·배합 맥락에서 비교합니다."},"skos:scopeNote":{"@value":"경악전서 좌귀환 기본 8미의 진음·정혈 보충 맥락. 신음허의 건조·도한·허열·요슬무력과 소화 상태를 함께 살피며, 삼사약 부재, 천우슬·귀판교의 사용 조건과 녹각교·귀판교의 교질 원료를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#warm-kidney-yang","@type":["skos:Concept","km:TreatmentPrinciple"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"온보신양","@language":"ko"},"skos:altLabel":["溫補腎陽"],"skos:definition":{"@value":"신양허에서 양을 따뜻하게 보하는 전통 치법. 수분대사·기화와 정혈·근골 보충의 비중을 나누어 배합한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/differentials/kidney-yin-vs-yang/#warm-kidney-yang"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"우귀환 — 경악전서 수록형","@language":"ko"},"skos:altLabel":["우귀환","右歸丸"],"skos:definition":{"@value":"경악전서 보진의 정혈 보익 바탕에 육계·법제 부자를 배합한 기본 10미 환제. 당귀의 사용 조건과 원전 증량 범위를 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#zuogui-jingyue","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"좌귀환 — 경악전서 수록형","@language":"ko"},"skos:altLabel":["좌귀환","左歸丸"],"skos:definition":{"@value":"경악전서 보진의 숙지황 중심 기본 8미 환제. 천우슬·귀판교의 사용 조건과 녹각교·귀판교의 교질 원료를 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/zuogui-wan/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
