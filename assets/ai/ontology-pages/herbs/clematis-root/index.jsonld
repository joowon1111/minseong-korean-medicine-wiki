{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#clematis-root","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"위령선","@language":"ko"},"skos:altLabel":["威靈仙"],"skos:definition":{"@value":"처방의 위령선 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/clematis-root/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shujing-huoxue-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소경활혈탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["소경활혈탕","疏經活血湯"],"skos:definition":{"@value":"만병회춘의 소경활혈탕 수록형. 해당 구성표의 16개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shujing-huoxue-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shujing-huoxue-wanbing--containsHerb--clematis-root","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shujing-huoxue-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#clematis-root"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shujing-huoxue-tang/#source-dose-original"},"dcterms:description":{"@value":"| [위령선](../herbs/clematis-root.md) · 威靈仙 | 1전 | 술로 씻음 | 거풍습·통락으로 경락·관절의 정체를 다룸 |"},"skos:scopeNote":{"@value":"만병회춘 소경활혈탕의 구성표 기본 약미. 원문 약명 威靈仙, 수록량 1전, 포제 술로 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
