{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하백출천마탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["반하백출천마탕","半夏白朮天麻湯"],"skos:definition":{"@value":"비위론의 기본 13미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-houpo-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하후박탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["반하후박탕","半夏厚朴湯"],"skos:definition":{"@value":"금궤요략 부인잡병편의 반하·후박·복령·생강·건소엽 5미 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-houpo-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"팔진탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["팔진탕","八珍湯","팔물탕","八物湯"],"skos:definition":{"@value":"만병회춘의 팔진탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#danggui-shaoyao-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"당귀작약산 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["당귀작약산","當歸芍藥散"],"skos:definition":{"@value":"금궤요략의 당귀작약산 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/danggui-shaoyao-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#duhuo-jisheng-qianjin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"독활기생탕 — 비급천금요방 수록형","@language":"ko"},"skos:altLabel":["독활기생탕","獨活寄生湯"],"skos:definition":{"@value":"비급천금요방의 독활기생탕 수록형. 해당 구성표의 15개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/duhuo-jisheng-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#erchen-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"이진탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["이진탕","二陳湯"],"skos:definition":{"@value":"국방의 이진탕 수록형. 해당 구성표의 4개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/erchen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guizhi-fuling-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"계지복령환 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["계지복령환","桂枝茯苓丸"],"skos:definition":{"@value":"금궤요략의 계지복령환 수록형. 해당 구성표의 5개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/guizhi-fuling-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-donguibogam-ipmun","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"경옥고 — 동의보감 입문 인용 수록형","@language":"ko"},"skos:altLabel":["경옥고","瓊玉膏"],"skos:definition":{"@value":"동의보감 입문 인용의 경옥고 배합. 생지황 16근·인삼 24량·백복령 48량·백밀 10근의 전체 제조 비율을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#donguibogam-variants"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-donguibogam-wisaeng","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"경옥고 — 동의보감 위생방 별기 수록형","@language":"ko"},"skos:altLabel":["경옥고","瓊玉膏"],"skos:definition":{"@value":"동의보감 위생방 별기의 경옥고 배합. 생지황 8근·인삼 32량·백복령 24량·백밀 5근의 전체 제조 비율을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#donguibogam-variants"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-hongshi","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"경옥고 — 홍씨집험방 수록형","@language":"ko"},"skos:altLabel":["경옥고","瓊玉膏"],"skos:definition":{"@value":"홍씨집험방의 경옥고 수록형. 해당 구성표의 4개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huoxiang-zhengqi-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"곽향정기산 — 국방 수록형","@language":"ko"},"skos:altLabel":["곽향정기산","藿香正氣散"],"skos:definition":{"@value":"국방의 곽향정기산 수록형. 구성표의 기본 11미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/huoxiang-zhengqi-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 방약합편 향부자·맥문동 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"방약합편 가미온담탕B P0004114의 기본 11미와 전탕 생강·대조를 기록한 별도 수록형.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 만병회춘 허번 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"만병회춘의 기본 11미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-xiaoyao-neike","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미소요산 — 내과적요 수록형","@language":"ko"},"skos:altLabel":["가미소요산","加味逍遙散"],"skos:definition":{"@value":"내과적요의 가미소요산 수록형. 구성표의 기본 8미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-xiaoyao-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육군자탕 — 의학심오 수록형","@language":"ko"},"skos:altLabel":["육군자탕","六君子湯"],"skos:definition":{"@value":"의학심오의 복령 포함 여섯 기본 약미와 생강·대조를 함께 기록한 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuwei-xiaoer","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"지황환(육미지황환) — 소아약증직결 수록형","@language":"ko"},"skos:altLabel":["지황환","육미지황환","地黃丸","六味地黃丸"],"skos:definition":{"@value":"소아약증직결의 지황환·육미지황환 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liuwei-dihuang-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"복령","@language":"ko"},"skos:altLabel":["茯苓"],"skos:definition":{"@value":"복령의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/poria/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#red-poria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"적복령","@language":"ko"},"skos:altLabel":["赤茯苓"],"skos:definition":{"@value":"처방에 赤茯苓으로 기록된 복령 약재의 명칭. 복령·백복령·복신 표기와 약용 부위를 구분해 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/poria/#red-poria-in-formulas"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양영탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양영탕","人參養榮湯"],"skos:definition":{"@value":"국방의 인삼양영탕 수록형. 구성표의 기본 12미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shenling-baizhu-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"삼령백출산 — 국방 수록형","@language":"ko"},"skos:altLabel":["삼령백출산","參苓白朮散"],"skos:definition":{"@value":"국방의 삼령백출산 수록형. 구성표의 기본 10미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shenling-baizhu-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shenqi-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"신기환·팔미신기환 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["신기환","팔미신기환","팔미지황환","腎氣丸","八味腎氣丸"],"skos:definition":{"@value":"금궤요략의 신기환·팔미신기환 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/bawei-dihuang-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"십전대보탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["십전대보탕","十全大補湯"],"skos:definition":{"@value":"국방의 십전대보탕 수록형. 해당 구성표의 10개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shujing-huoxue-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소경활혈탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["소경활혈탕","疏經活血湯"],"skos:definition":{"@value":"만병회춘의 소경활혈탕 수록형. 해당 구성표의 16개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shujing-huoxue-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#sijunzi-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"사군자탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["사군자탕","四君子湯"],"skos:definition":{"@value":"태평혜민화제국방 권3의 인삼·백출·복령·자감초 등분 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/sijunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-baizhu-tianma-piwei--containsHerb--white-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"},"dcterms:description":{"@value":"| [백복령](../herbs/poria.md) · 白茯苓 | 5分 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"비위론 13미 수록형. 황백 二分·주세, 건강 三分, 천마·창출·백복령·황기·택사·인삼 각 五分, 백출·炒曲 각 一錢, 반하 湯洗七次·대맥얼면·귤피 각 一錢五分. 매회 半兩을 물 二盞에서 一盞으로 달여 거재·열복·식전. 동의보감의 생강 5쪽 추가는 별도 수록형이며 이 기본 구성에 합치지 않는다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-houpo-jinkui--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-houpo-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-houpo-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 4량 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"금궤요략 부인잡병편의 기본 5미. 반하 1승은 부피, 후박 3량·복령 4량·생강 5량·건소엽 2량은 중량 기록이다. 건소엽은 말린 잎의 원문 명칭으로 보존하며, 후대 대칠기탕의 조말·생강 추가 방식과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 1전 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 茯苓, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-danggui-shaoyao-jinkui--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#danggui-shaoyao-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/danggui-shaoyao-san/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 4량 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"금궤요략 당귀작약산의 구성표 기본 약미. 원문 약명 茯苓, 수록량 4량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-duhuo-jisheng-qianjin--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#duhuo-jisheng-qianjin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/duhuo-jisheng-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 2량 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"비급천금요방 독활기생탕의 구성표 기본 약미. 원문 약명 茯苓, 수록량 2량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-erchen-guofang--containsHerb--white-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#erchen-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/erchen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 白茯苓 | 3량 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"국방 이진탕의 구성표 기본 약미. 원문 약명 白茯苓, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-guizhi-fuling-jinkui--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guizhi-fuling-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/guizhi-fuling-wan/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 등분 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"금궤요략 계지복령환의 구성표 기본 약미. 원문 약명 茯苓, 수록량 등분, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-gyeongok-donguibogam-ipmun--containsHerb--white-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-donguibogam-ipmun"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#donguibogam-variants"},"dcterms:description":{"@value":"| 수록형 | 생지황 | 인삼 | 백복령 | 백밀 |\n|---|---|---|---|---|\n| 《동의보감》에 인용된 《입문》 계열 | 16근, 즙 | 24량, 세말 | 48량, 세말 | 10근, 정련 |\n| 같은 조문에 별기한 《위생방》 | 8근 | 32량 | 24량 | 5근 |"},"skos:scopeNote":{"@value":"동의보감 입문 인용 경옥고의 제조 배합: 생지황 16근·인삼 24량·백복령 48량·백밀 10근. 표의 열 순서는 생지황·인삼·백복령·백밀이며 홍씨집험방의 복령 49량형과 구분한다. 제형·수치와 전체 제조량은 출처에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-gyeongok-donguibogam-wisaeng--containsHerb--white-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-donguibogam-wisaeng"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#donguibogam-variants"},"dcterms:description":{"@value":"| 수록형 | 생지황 | 인삼 | 백복령 | 백밀 |\n|---|---|---|---|---|\n| 《동의보감》에 인용된 《입문》 계열 | 16근, 즙 | 24량, 세말 | 48량, 세말 | 10근, 정련 |\n| 같은 조문에 별기한 《위생방》 | 8근 | 32량 | 24량 | 5근 |"},"skos:scopeNote":{"@value":"동의보감 위생방 별기 경옥고의 제조 배합: 생지황 8근·인삼 32량·백복령 24량·백밀 5근. 표의 열 순서는 생지황·인삼·백복령·백밀이며 홍씨집험방의 복령 49량형과 구분한다. 제형·수치와 전체 제조량은 출처에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-gyeongok-hongshi--containsHerb--white-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-hongshi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 雪白茯苓 | 49량 | 나무 도구로 1,000회 찧음·가루로 만듦 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"홍씨집험방 경옥고의 구성표 기본 약미. 원문 약명 雪白茯苓, 수록량 49량, 포제 나무 도구로 1,000회 찧음·가루로 만듦. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-huoxiang-zhengqi-guofang--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huoxiang-zhengqi-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/huoxiang-zhengqi-san/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 1량 | 껍질 제거 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"국방 곽향정기산의 기본 구성. 원문 약명 茯苓, 수록량 1량, 포제 껍질 제거. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-bangyak--containsHerb--white-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"},"dcterms:description":{"@value":"| 백복령 | 2.25 g |"},"skos:scopeNote":{"@value":"방약합편 가미온담탕B P0004114에 제시된 국내 11미형과 DB 환산 용량. 향부자 9 g·귤홍 4.5 g·반하/죽여/지실 각 3 g·길경/맥문동/백복령/시호/인삼 각 2.25 g·감초 1.5 g. 생강 3편·대조 2매는 전탕 추가재료. 만병회춘의 숙지황·산조인·원지·오미자형 및 역사적 단위와 구분한다. DB 환산량을 고전 원문 g 표기로 대체하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-wanbing--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 一錢，一分 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"만병회춘 허번의 기본 11미. 반하 泡七次 三錢半, 죽여·지실 麩炒 각 一錢半, 진피 二錢二分, 복령·감초 各一錢，一分의 공개 전사 표기를 보존하고 확정량으로 정규화하지 않는다. 산조인 炒·원지 去心·오미자·인삼·숙지황 각 一錢. 上銼一劑·薑棗煎服은 생강·대조를 더하는 전탕 조건이며 개수는 미기재다. 방약합편 향부자·맥문동형과 구성·약량을 구분한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-xiaoyao-neike--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-xiaoyao-neike"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-xiaoyao-san/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 1전 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"내과적요 가미소요산의 기본 구성. 원문 약명 茯苓, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liujunzi-yixuexinwu--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 1전 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"의학심오 수록형. 인삼·복령·백출·진피·감초·반하의 기본 6미에 생강·대조를 포함한다. 백출 진토초·진피 거백·감초 자·반하 탕포칠차 등 원문 포제를 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuwei-xiaoer--containsHerb--white-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuwei-xiaoer"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/liuwei-dihuang-wan/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 白茯苓 | 3전 | 껍질 제거 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"소아약증직결 지황환·육미지황환의 구성표 기본 약미. 원문 약명 白茯苓, 수록량 3전, 포제 껍질 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangrong-guofang--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 7전반 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"국방 인삼양영탕의 기본 구성. 원문 약명 茯苓, 수록량 7전반, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shenling-baizhu-guofang--containsHerb--white-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shenling-baizhu-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shenling-baizhu-san/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 白茯苓 | 2근 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"국방 삼령백출산의 기본 구성. 원문 약명 白茯苓, 수록량 2근, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shenqi-jinkui--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shenqi-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bawei-dihuang-wan/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 3량 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"금궤요략 신기환·팔미신기환의 구성표 기본 약미. 원문 약명 茯苓, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shiquan-guofang--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 등분 | 배(약한 열로 말림) | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"국방 십전대보탕의 구성표 기본 약미. 원문 약명 茯苓, 수록량 등분, 포제 배(약한 열로 말림). 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shujing-huoxue-wanbing--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shujing-huoxue-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shujing-huoxue-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 7푼 | 껍질 제거 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"만병회춘 소경활혈탕의 구성표 기본 약미. 원문 약명 茯苓, 수록량 7푼, 포제 껍질 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-sijunzi-guofang--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#sijunzi-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/sijunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 등분 | 껍질 제거 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"태평혜민화제국방 권3, 각 등분. 인삼 거로·복령 거피·감초 자(炙). 원문 제조 비율이며 현대 1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-suanzaoren-donguibogam--containsHerb--red-poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#suanzaoren-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#red-poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/suanzaoren-tang/#donguibogam-version"},"dcterms:description":{"@value":"| [적복령](../herbs/poria.md#red-poria-in-formulas) · 赤茯苓 | 1전 |"},"skos:scopeNote":{"@value":"동의보감 내경편 권2 몽·의학입문 인용 수록형의 기본 7미. 산조인 초(炒), 적복령·계심의 원문 명칭과 역사적 약량을 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-suanzaoren-jinkui--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#suanzaoren-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/suanzaoren-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 2량 | 별도 포제 표기 없음 | 영심안신을 돕고 건비·삼습으로 배합을 받침 |"},"skos:scopeNote":{"@value":"금궤요략 5미 수록형. 深師有生薑二兩는 이본 주석으로 구별한다. 산조인 부피 단위와 다른 약미의 중량 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-tianwang-buxin-yifang--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#tianwang-buxin-yifang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/tianwang-buxin-dan/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 5전 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"의방집해 기본 13미와 봉밀 제환. 생지황 酒洗 四兩, 인삼·현삼·단삼·복령·길경·원지 각 五錢, 산조인·백자인·천문동·맥문동·당귀·오미자 각 一兩은 원문의 연속 열거를 묶어 읽은 해석이다. 현삼·단삼·원지·산조인·백자인·천문동·맥문동·오미자의 炒, 백자인 研去油, 당귀 酒洗를 보존한다. 茯苓一用茯神은 대용 기록이다. 봉밀은 제환 재료, 硃砂為衣는 역사적 환의, 燈心湯은 복용 매개로 구분한다. 임와 一丸 또는 함화 기록이며 현대 주사 제외 제제의 실제 구성·용량은 제품별 확인한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 1량반 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 茯苓, 수록량 1량반, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wuling-shanghan--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wuling-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wuling-san/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 18수 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"상한론 송본 오령산의 구성표 기본 약미. 원문 약명 茯苓, 수록량 18수, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiangsha-liujunzi-shifang--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 2전 | 별도 포제 표기 없음 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"시방가괄 향사육군자탕의 구성표 기본 약미. 원문 약명 茯苓, 수록량 2전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoyao-guofang--containsHerb--poria","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoyao-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#poria"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoyao-san/#source-dose-original"},"dcterms:description":{"@value":"| [복령](../herbs/poria.md) · 茯苓 | 1량 | 껍질 제거 | 건비·삼습으로 수습의 정체를 조절 |"},"skos:scopeNote":{"@value":"국방 소요산의 기본 구성. 원문 약명 茯苓, 수록량 1량, 포제 껍질 제거. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#suanzaoren-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"산조인탕 — 동의보감 몽문 수록형","@language":"ko"},"skos:altLabel":["산조인탕","酸棗仁湯"],"skos:definition":{"@value":"동의보감 내경편 권2 몽문의 석고·산조인·인삼·지모·적복령·감초·계심 7미에 생강을 더해 달이는 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/suanzaoren-tang/#donguibogam-version"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#suanzaoren-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"산조인탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["산조인탕","酸棗仁湯"],"skos:definition":{"@value":"금궤요략 허로편의 산조인·지모·복령·천궁·감초 5미 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/suanzaoren-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#tianwang-buxin-yifang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"천왕보심단 — 의방집해 수록형","@language":"ko"},"skos:altLabel":["천왕보심단","天王補心丹"],"skos:definition":{"@value":"의방집해의 기본 13미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/tianwang-buxin-dan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"온담탕 — 삼인극일병증방론 수록형","@language":"ko"},"skos:altLabel":["온담탕","溫膽湯"],"skos:definition":{"@value":"삼인극일병증방론의 온담탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#white-poria","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"백복령","@language":"ko"},"skos:altLabel":["白茯苓","雪白茯苓"],"skos:definition":{"@value":"처방의 백복령 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/poria/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wuling-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"오령산 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["오령산","五苓散"],"skos:definition":{"@value":"상한론 송본의 오령산 수록형. 해당 구성표의 5개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/wuling-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"향사육군자탕 — 시방가괄 수록형","@language":"ko"},"skos:altLabel":["향사육군자탕","香砂六君子湯"],"skos:definition":{"@value":"시방가괄의 향사육군자탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoyao-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소요산 — 국방 수록형","@language":"ko"},"skos:altLabel":["소요산","逍遙散"],"skos:definition":{"@value":"국방의 소요산 수록형. 구성표의 기본 6미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoyao-san/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
