{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"팔진탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["팔진탕","八珍湯","팔물탕","八物湯"],"skos:definition":{"@value":"만병회춘의 팔진탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 만병회춘 허번 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"만병회춘의 기본 11미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuwei-xiaoer","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"지황환(육미지황환) — 소아약증직결 수록형","@language":"ko"},"skos:altLabel":["지황환","육미지황환","地黃丸","六味地黃丸"],"skos:definition":{"@value":"소아약증직결의 지황환·육미지황환 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liuwei-dihuang-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"숙지황","@language":"ko"},"skos:altLabel":["熟乾地黃","熟地黃","地黃"],"skos:definition":{"@value":"처방의 숙지황 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/prepared-rehmannia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양영탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양영탕","人參養榮湯"],"skos:definition":{"@value":"국방의 인삼양영탕 수록형. 구성표의 기본 12미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"십전대보탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["십전대보탕","十全大補湯"],"skos:definition":{"@value":"국방의 십전대보탕 수록형. 해당 구성표의 10개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#siwu-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"사물탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["사물탕","四物湯"],"skos:definition":{"@value":"국방의 사물탕 수록형. 해당 구성표의 4개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/siwu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"쌍화탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["쌍화탕","雙和湯"],"skos:definition":{"@value":"국방의 쌍화탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 熟地黃 | 1전 | 별도 포제 표기 없음 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 熟地黃, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-wanbing--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 熟地黃 | 1전 | 별도 포제 표기 없음 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"만병회춘 허번의 기본 11미. 반하 泡七次 三錢半, 죽여·지실 麩炒 각 一錢半, 진피 二錢二分, 복령·감초 各一錢，一分의 공개 전사 표기를 보존하고 확정량으로 정규화하지 않는다. 산조인 炒·원지 去心·오미자·인삼·숙지황 각 一錢. 上銼一劑·薑棗煎服은 생강·대조를 더하는 전탕 조건이며 개수는 미기재다. 방약합편 향부자·맥문동형과 구성·약량을 구분한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuwei-xiaoer--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuwei-xiaoer"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/liuwei-dihuang-wan/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 熟地黃 | 8전 | 별도 포제 표기 없음 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"소아약증직결 지황환·육미지황환의 구성표 기본 약미. 원문 약명 熟地黃, 수록량 8전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangrong-guofang--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 熟地黃 | 7전반 | 법제 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"국방 인삼양영탕의 기본 구성. 원문 약명 熟地黃, 수록량 7전반, 포제 법제. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shiquan-guofang--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 地黃 | 등분 | 씻음·술을 사용해 찜·배(약한 열로 말림) | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"국방 십전대보탕의 구성표 기본 약미. 원문 약명 地黃, 수록량 등분, 포제 씻음·술을 사용해 찜·배(약한 열로 말림). 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-siwu-guofang--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#siwu-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/siwu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 熟乾地黃 | 등분 | 술을 뿌림·찜 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"국방 사물탕의 구성표 기본 약미. 원문 약명 熟乾地黃, 수록량 등분, 포제 술을 뿌림·찜. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 熟地黃 | 3량 | 깨끗이 씻음·술을 사용해 찜 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 熟地黃, 수록량 3량, 포제 깨끗이 씻음·술을 사용해 찜. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yougui-jingyue--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 大懷熟 | 8량 | 별도 포제 표기 없음 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"경악전서 우귀환의 기본 10미 환제. 원문 약명 大懷熟, 수록량 8량, 포제 별도 포제 표기 없음. 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-zuogui-jingyue--containsHerb--prepared-rehmannia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#zuogui-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#prepared-rehmannia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/zuogui-wan/#source-dose-original"},"dcterms:description":{"@value":"| [숙지황](../herbs/prepared-rehmannia.md) · 大懷熟 | 8량 | 별도 포제 표기 없음 | 음혈·정혈을 기르는 자윤한 보익축 |"},"skos:scopeNote":{"@value":"경악전서 좌귀환의 기본 8미 환제. 원문 약명 大懷熟, 수록량 8량, 포제 별도 포제 표기 없음. 역사적 제조 배합이며 현대 제제·1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yougui-jingyue","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"우귀환 — 경악전서 수록형","@language":"ko"},"skos:altLabel":["우귀환","右歸丸"],"skos:definition":{"@value":"경악전서 보진의 정혈 보익 바탕에 육계·법제 부자를 배합한 기본 10미 환제. 당귀의 사용 조건과 원전 증량 범위를 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yougui-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#zuogui-jingyue","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"좌귀환 — 경악전서 수록형","@language":"ko"},"skos:altLabel":["좌귀환","左歸丸"],"skos:definition":{"@value":"경악전서 보진의 숙지황 중심 기본 8미 환제. 천우슬·귀판교의 사용 조건과 녹각교·귀판교의 교질 원료를 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/zuogui-wan/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
