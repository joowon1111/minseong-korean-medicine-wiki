{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하백출천마탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["반하백출천마탕","半夏白朮天麻湯"],"skos:definition":{"@value":"비위론의 기본 13미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-xiexin-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하사심탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["반하사심탕","半夏瀉心湯"],"skos:definition":{"@value":"상한론 송본의 반하사심탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-xiexin-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"팔진탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["팔진탕","八珍湯","팔물탕","八物湯"],"skos:definition":{"@value":"만병회춘의 팔진탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#buzhong-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"보중익기탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["보중익기탕","補中益氣湯"],"skos:definition":{"@value":"비위론의 보중익기탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/buzhong-yiqi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#duhuo-jisheng-qianjin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"독활기생탕 — 비급천금요방 수록형","@language":"ko"},"skos:altLabel":["독활기생탕","獨活寄生湯"],"skos:definition":{"@value":"비급천금요방의 독활기생탕 수록형. 해당 구성표의 15개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/duhuo-jisheng-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼","@language":"ko"},"skos:altLabel":["人參"],"skos:definition":{"@value":"인삼의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/ginseng/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"귀비탕 — 동의보감 수록형","@language":"ko"},"skos:altLabel":["귀비탕","歸脾湯"],"skos:definition":{"@value":"동의보감 내경편 권1 신·건망의 귀비탕. 당귀·원지를 포함한 10미와 전탕 추가 생강·대추를 기록한 수록형.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#donguibogam-version"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-jisheng","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"귀비탕 — 제생방 수록형","@language":"ko"},"skos:altLabel":["귀비탕","歸脾湯"],"skos:definition":{"@value":"제생방의 귀비탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-donguibogam-ipmun","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"경옥고 — 동의보감 입문 인용 수록형","@language":"ko"},"skos:altLabel":["경옥고","瓊玉膏"],"skos:definition":{"@value":"동의보감 입문 인용의 경옥고 배합. 생지황 16근·인삼 24량·백복령 48량·백밀 10근의 전체 제조 비율을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#donguibogam-variants"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-donguibogam-wisaeng","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"경옥고 — 동의보감 위생방 별기 수록형","@language":"ko"},"skos:altLabel":["경옥고","瓊玉膏"],"skos:definition":{"@value":"동의보감 위생방 별기의 경옥고 배합. 생지황 8근·인삼 32량·백복령 24량·백밀 5근의 전체 제조 비율을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#donguibogam-variants"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-hongshi","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"경옥고 — 홍씨집험방 수록형","@language":"ko"},"skos:altLabel":["경옥고","瓊玉膏"],"skos:definition":{"@value":"홍씨집험방의 경옥고 수록형. 해당 구성표의 4개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 방약합편 향부자·맥문동 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"방약합편 가미온담탕B P0004114의 기본 11미와 전탕 생강·대조를 기록한 별도 수록형.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 만병회춘 허번 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"만병회춘의 기본 11미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육군자탕 — 의학심오 수록형","@language":"ko"},"skos:altLabel":["육군자탕","六君子湯"],"skos:definition":{"@value":"의학심오의 복령 포함 여섯 기본 약미와 생강·대조를 함께 기록한 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#lizhong-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"이중환 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["이중환","이중탕","理中丸"],"skos:definition":{"@value":"상한론 송본 곽란병편의 이중환 4미 수록형. 환제와 별도로 기록한 탕법, 약량·가감을 해당 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/lizhong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maimendong-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"맥문동탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["맥문동탕","麥門冬湯"],"skos:definition":{"@value":"금궤요략의 맥문동탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/maidong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양영탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양영탕","人參養榮湯"],"skos:definition":{"@value":"국방의 인삼양영탕 수록형. 구성표의 기본 12미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangwei-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양위탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양위탕","人參養胃湯","人蔘養胃湯"],"skos:definition":{"@value":"국방 淳祐新添方 인삼양위탕 기본 9미의 일괄 제조 배합. 半夏 湯洗七次·厚朴 去粗皮薑汁製·蒼朮 米泔浸一宿洗切炒 각 一兩, 藿香葉 洗去土·草果 去皮膜·茯苓 去黑皮·人參 각 半兩, 甘草 炙 二錢半, 橘紅 七錢半. 每服四錢·水一盞半·姜七片·烏梅一個·煎至六分·去滓熱服을 보존한다. 생강·오매는 매복 전탕 추가재료이며 대조는 이 수록형에 없다. 후대 방약합편의 진피·적복령·생강3편·대조2매와 구분하고 제조 총량을 현대 1일량으로 환산하지 않는다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangwei-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#samchul-geonbi-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"삼출건비탕 — 동의보감 집략 인용 수록형","@language":"ko"},"skos:altLabel":["삼출건비탕","參朮健脾湯","蔘朮健脾湯"],"skos:definition":{"@value":"동의보감 잡병편 권4 내상 食傷補益之劑의 集略 인용 삼출건비탕 기본 12미와 전탕 생강·대조. 인삼·백출·白茯苓·후박·陳皮·山査肉 각 一錢, 枳實·白芍藥 각 八分, 神麴·麥芽·縮砂·甘草 각 五分. 剉作一貼·入薑三棗二水煎服 기록을 보존하고 제법 대조의 생강 3쪽·대조 2매를 전탕 추가재료로 구분한다. 해당 대목의 포제 미기재를 후대 처방으로 채우지 않는다. 지실을 뺀 2002년 해설서 B형 및 현대 DB g 환산량과 구분하며, 정전가미이진탕의 신곡·맥아면 별포·조입 조건을 가져오지 않는다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/samchul-geonbi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shengmai-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"생맥산 — 동의보감 수록형","@language":"ko"},"skos:altLabel":["생맥산","生脈散"],"skos:definition":{"@value":"동의보감 잡병편 서·하서의보기의 맥문동 2전·인삼 1전·오미자 1전 구성. 의학심오의 오미자 15립형과 구별한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shengmai-san/#donguibogam-version"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shengmai-yixuexinwu","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"생맥산 — 의학심오 수록형","@language":"ko"},"skos:altLabel":["생맥산","生脈散"],"skos:definition":{"@value":"의학심오의 생맥산 수록형. 해당 구성표의 3개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shengmai-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shenling-baizhu-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"삼령백출산 — 국방 수록형","@language":"ko"},"skos:altLabel":["삼령백출산","參苓白朮散"],"skos:definition":{"@value":"국방의 삼령백출산 수록형. 구성표의 기본 10미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shenling-baizhu-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"십전대보탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["십전대보탕","十全大補湯"],"skos:definition":{"@value":"국방의 십전대보탕 수록형. 해당 구성표의 10개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#sijunzi-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"사군자탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["사군자탕","四君子湯"],"skos:definition":{"@value":"태평혜민화제국방 권3의 인삼·백출·복령·자감초 등분 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/sijunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-baizhu-tianma-piwei--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 5分 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"비위론 13미 수록형. 황백 二分·주세, 건강 三分, 천마·창출·백복령·황기·택사·인삼 각 五分, 백출·炒曲 각 一錢, 반하 湯洗七次·대맥얼면·귤피 각 一錢五分. 매회 半兩을 물 二盞에서 一盞으로 달여 거재·열복·식전. 동의보감의 생강 5쪽 추가는 별도 수록형이며 이 기본 구성에 합치지 않는다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-xiexin-shanghan--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-xiexin-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-xiexin-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 3량 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"상한론 송본 반하사심탕의 구성표 기본 약미. 원문 약명 人參, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 1전 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 人參, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-buzhong-piwei--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#buzhong-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/buzhong-yiqi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 三分 | 마디 제거 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"비위론 보중익기탕의 구성표 기본 약미. 원문 약명 人參, 수록량 三分, 포제 마디 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-duhuo-jisheng-qianjin--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#duhuo-jisheng-qianjin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/duhuo-jisheng-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 2량 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"비급천금요방 독활기생탕의 구성표 기본 약미. 원문 약명 人參, 수록량 2량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-guibi-donguibogam--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#donguibogam-version"},"dcterms:description":{"@value":"| 당귀·용안육·산조인·원지·인삼·황기·백출·복신 | 각 1전; 산조인은 초(炒), 원지는 제(製) |"},"skos:scopeNote":{"@value":"동의보감 내경편 신·건망의 의학입문 인용 수록형. 이 행의 8미 각 1전; 산조인 초·원지 제. 제생방 8미형과 당귀·원지의 유무를 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-guibi-jisheng--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-jisheng"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 반량 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"제생방 귀비탕의 구성표 기본 약미. 원문 약명 人參, 수록량 반량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-gyeongok-donguibogam-ipmun--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-donguibogam-ipmun"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#donguibogam-variants"},"dcterms:description":{"@value":"| 수록형 | 생지황 | 인삼 | 백복령 | 백밀 |\n|---|---|---|---|---|\n| 《동의보감》에 인용된 《입문》 계열 | 16근, 즙 | 24량, 세말 | 48량, 세말 | 10근, 정련 |\n| 같은 조문에 별기한 《위생방》 | 8근 | 32량 | 24량 | 5근 |"},"skos:scopeNote":{"@value":"동의보감 입문 인용 경옥고의 제조 배합: 생지황 16근·인삼 24량·백복령 48량·백밀 10근. 표의 열 순서는 생지황·인삼·백복령·백밀이며 홍씨집험방의 복령 49량형과 구분한다. 제형·수치와 전체 제조량은 출처에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-gyeongok-donguibogam-wisaeng--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-donguibogam-wisaeng"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#donguibogam-variants"},"dcterms:description":{"@value":"| 수록형 | 생지황 | 인삼 | 백복령 | 백밀 |\n|---|---|---|---|---|\n| 《동의보감》에 인용된 《입문》 계열 | 16근, 즙 | 24량, 세말 | 48량, 세말 | 10근, 정련 |\n| 같은 조문에 별기한 《위생방》 | 8근 | 32량 | 24량 | 5근 |"},"skos:scopeNote":{"@value":"동의보감 위생방 별기 경옥고의 제조 배합: 생지황 8근·인삼 32량·백복령 24량·백밀 5근. 표의 열 순서는 생지황·인삼·백복령·백밀이며 홍씨집험방의 복령 49량형과 구분한다. 제형·수치와 전체 제조량은 출처에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-gyeongok-hongshi--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gyeongok-hongshi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/gyeongok-go/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 新羅人參 | 24량 | 1,000회 찧음·가루로 만듦 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"홍씨집험방 경옥고의 구성표 기본 약미. 원문 약명 新羅人參, 수록량 24량, 포제 1,000회 찧음·가루로 만듦. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-bangyak--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"},"dcterms:description":{"@value":"| 인삼 | 2.25 g |"},"skos:scopeNote":{"@value":"방약합편 가미온담탕B P0004114에 제시된 국내 11미형과 DB 환산 용량. 향부자 9 g·귤홍 4.5 g·반하/죽여/지실 각 3 g·길경/맥문동/백복령/시호/인삼 각 2.25 g·감초 1.5 g. 생강 3편·대조 2매는 전탕 추가재료. 만병회춘의 숙지황·산조인·원지·오미자형 및 역사적 단위와 구분한다. DB 환산량을 고전 원문 g 표기로 대체하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-wanbing--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 1전 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"만병회춘 허번의 기본 11미. 반하 泡七次 三錢半, 죽여·지실 麩炒 각 一錢半, 진피 二錢二分, 복령·감초 各一錢，一分의 공개 전사 표기를 보존하고 확정량으로 정규화하지 않는다. 산조인 炒·원지 去心·오미자·인삼·숙지황 각 一錢. 上銼一劑·薑棗煎服은 생강·대조를 더하는 전탕 조건이며 개수는 미기재다. 방약합편 향부자·맥문동형과 구성·약량을 구분한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liujunzi-yixuexinwu--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 1전 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"의학심오 수록형. 인삼·복령·백출·진피·감초·반하의 기본 6미에 생강·대조를 포함한다. 백출 진토초·진피 거백·감초 자·반하 탕포칠차 등 원문 포제를 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-lizhong-shanghan--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#lizhong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/lizhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 3량 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"상한론 송본 이중환·이중탕의 기본 구성. 원문 약명 人參, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-maimendong-jinkui--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maimendong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/maidong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 3량 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"금궤요략 맥문동탕의 구성표 기본 약미. 원문 약명 人參, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangrong-guofang--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 1량 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"국방 인삼양영탕의 기본 구성. 원문 약명 人參, 수록량 1량, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangwei-guofang--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangwei-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangwei-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 半兩 | 별도 포제 표기 없음 |"},"skos:scopeNote":{"@value":"국방 淳祐新添方 인삼양위탕 기본 9미의 일괄 제조 배합. 半夏 湯洗七次·厚朴 去粗皮薑汁製·蒼朮 米泔浸一宿洗切炒 각 一兩, 藿香葉 洗去土·草果 去皮膜·茯苓 去黑皮·人參 각 半兩, 甘草 炙 二錢半, 橘紅 七錢半. 每服四錢·水一盞半·姜七片·烏梅一個·煎至六分·去滓熱服을 보존한다. 생강·오매는 매복 전탕 추가재료이며 대조는 이 수록형에 없다. 후대 방약합편의 진피·적복령·생강3편·대조2매와 구분하고 제조 총량을 현대 1일량으로 환산하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-samchul-geonbi-donguibogam--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#samchul-geonbi-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/samchul-geonbi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 一錢 | 별도 포제 표기 없음 |"},"skos:scopeNote":{"@value":"동의보감 잡병편 권4 내상 食傷補益之劑의 集略 인용 삼출건비탕 기본 12미와 전탕 생강·대조. 인삼·백출·白茯苓·후박·陳皮·山査肉 각 一錢, 枳實·白芍藥 각 八分, 神麴·麥芽·縮砂·甘草 각 五分. 剉作一貼·入薑三棗二水煎服 기록을 보존하고 제법 대조의 생강 3쪽·대조 2매를 전탕 추가재료로 구분한다. 해당 대목의 포제 미기재를 후대 처방으로 채우지 않는다. 지실을 뺀 2002년 해설서 B형 및 현대 DB g 환산량과 구분하며, 정전가미이진탕의 신곡·맥아면 별포·조입 조건을 가져오지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shengmai-donguibogam--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shengmai-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shengmai-san/#donguibogam-version"},"dcterms:description":{"@value":"| 인삼 | 1전 | 익기 |"},"skos:scopeNote":{"@value":"동의보감 잡병편 서의 2:1:1 수록형. 의학심오의 2전·1전·15립형과 원 단위를 각각 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shengmai-yixuexinwu--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shengmai-yixuexinwu"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shengmai-san/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 1전 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"의학심오 생맥산의 구성표 기본 약미. 원문 약명 人參, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shenling-baizhu-guofang--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shenling-baizhu-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shenling-baizhu-san/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 2근 | 노두 제거 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"국방 삼령백출산의 기본 구성. 원문 약명 人參, 수록량 2근, 포제 노두 제거. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shiquan-guofang--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 등분 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"국방 십전대보탕의 구성표 기본 약미. 원문 약명 人參, 수록량 등분, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-sijunzi-guofang--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#sijunzi-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/sijunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 등분 | 노두 제거 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"태평혜민화제국방 권3, 각 등분. 인삼 거로·복령 거피·감초 자(炙). 원문 제조 비율이며 현대 1일량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-suanzaoren-donguibogam--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#suanzaoren-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/suanzaoren-tang/#donguibogam-version"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 1전 5푼 |"},"skos:scopeNote":{"@value":"동의보감 내경편 권2 몽·의학입문 인용 수록형의 기본 7미. 산조인 초(炒), 적복령·계심의 원문 명칭과 역사적 약량을 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-tianwang-buxin-yifang--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#tianwang-buxin-yifang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/tianwang-buxin-dan/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 5전 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"의방집해 기본 13미와 봉밀 제환. 생지황 酒洗 四兩, 인삼·현삼·단삼·복령·길경·원지 각 五錢, 산조인·백자인·천문동·맥문동·당귀·오미자 각 一兩은 원문의 연속 열거를 묶어 읽은 해석이다. 현삼·단삼·원지·산조인·백자인·천문동·맥문동·오미자의 炒, 백자인 研去油, 당귀 酒洗를 보존한다. 茯苓一用茯神은 대용 기록이다. 봉밀은 제환 재료, 硃砂為衣는 역사적 환의, 燈心湯은 복용 매개로 구분한다. 임와 一丸 또는 함화 기록이며 현대 주사 제외 제제의 실제 구성·용량은 제품별 확인한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiangsha-liujunzi-shifang--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 2전 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"시방가괄 향사육군자탕의 구성표 기본 약미. 원문 약명 人參, 수록량 2전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--ginseng","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ginseng"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [인삼](../herbs/ginseng.md) · 人參 | 3량 | 별도 포제 표기 없음 | 기를 보하고 비위·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 人參, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#suanzaoren-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"산조인탕 — 동의보감 몽문 수록형","@language":"ko"},"skos:altLabel":["산조인탕","酸棗仁湯"],"skos:definition":{"@value":"동의보감 내경편 권2 몽문의 석고·산조인·인삼·지모·적복령·감초·계심 7미에 생강을 더해 달이는 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/suanzaoren-tang/#donguibogam-version"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#tianwang-buxin-yifang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"천왕보심단 — 의방집해 수록형","@language":"ko"},"skos:altLabel":["천왕보심단","天王補心丹"],"skos:definition":{"@value":"의방집해의 기본 13미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/tianwang-buxin-dan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"향사육군자탕 — 시방가괄 수록형","@language":"ko"},"skos:altLabel":["향사육군자탕","香砂六君子湯"],"skos:definition":{"@value":"시방가괄의 향사육군자탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소시호탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["소시호탕","小柴胡湯"],"skos:definition":{"@value":"상한론 송본의 소시호탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}