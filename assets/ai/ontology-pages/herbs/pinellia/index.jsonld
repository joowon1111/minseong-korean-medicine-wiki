{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하백출천마탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["반하백출천마탕","半夏白朮天麻湯"],"skos:definition":{"@value":"비위론의 기본 13미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-houpo-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하후박탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["반하후박탕","半夏厚朴湯"],"skos:definition":{"@value":"금궤요략 부인잡병편의 반하·후박·복령·생강·건소엽 5미 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-houpo-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-xiexin-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하사심탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["반하사심탕","半夏瀉心湯"],"skos:definition":{"@value":"상한론 송본의 반하사심탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-xiexin-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"보화환 — 단계심법 7미 수록형","@language":"ko"},"skos:altLabel":["보화환","保和丸"],"skos:definition":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#erchen-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"이진탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["이진탕","二陳湯"],"skos:definition":{"@value":"국방의 이진탕 수록형. 해당 구성표의 4개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/erchen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huoxiang-zhengqi-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"곽향정기산 — 국방 수록형","@language":"ko"},"skos:altLabel":["곽향정기산","藿香正氣散"],"skos:definition":{"@value":"국방의 곽향정기산 수록형. 구성표의 기본 11미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/huoxiang-zhengqi-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-erchen-yixuezhengzhuan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"정전가미이진탕 — 의학정전 도담보비 수록형","@language":"ko"},"skos:altLabel":["정전가미이진탕","正傳加味二陳湯"],"skos:definition":{"@value":"의학정전 加味二陳湯의 導痰補脾·消食行氣 수록형. 기본 12미의 橘紅·茯苓 각 七分, 半夏 湯泡洗 一錢, 甘草 炙 三分, 川芎·蒼朮·白朮 각 八分, 山楂肉 一錢五分, 砂仁 五分, 神麯 炒 七分, 香附子 一錢, 麥糵面 炒 五分. 生薑 三片·大棗 一枚는 전탕 추가재료. 神麯·麥糵面을 細研炒另包하고 나머지는 細切作一服하여 水二盞煎至一盞 후 두 분말을 調入한다. 모든 약미를 함께 전탕하는 것으로 바꾸지 않는다. 후대 방약합편의 백복령·대조 二枚 및 g 환산과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jeongjeon-gami-ijin-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 방약합편 향부자·맥문동 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"방약합편 가미온담탕B P0004114의 기본 11미와 전탕 생강·대조를 기록한 별도 수록형.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 만병회춘 허번 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"만병회춘의 기본 11미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육군자탕 — 의학심오 수록형","@language":"ko"},"skos:altLabel":["육군자탕","六君子湯"],"skos:definition":{"@value":"의학심오의 복령 포함 여섯 기본 약미와 생강·대조를 함께 기록한 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-yixuerumen","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육울탕 — 의학입문 9미 수록형","@language":"ko"},"skos:altLabel":["육울탕","六鬱湯"],"skos:definition":{"@value":"의학입문 郁類의 기본 9미. 진피·반하·천궁·창출 각 一錢, 적복령·산치자인 각 七分, 향부 二錢, 사인·감초 각 五分. 생강 三片은 별도 전탕 추가재료. 水煎服·隨證加減을 보존하고 개별 포제 미기재를 다른 수록형에서 채워 넣지 않는다. 동의보감 의감 인용 12미형 및 DB 환산량과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maimendong-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"맥문동탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["맥문동탕","麥門冬湯"],"skos:definition":{"@value":"금궤요략의 맥문동탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/maidong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하","@language":"ko"},"skos:altLabel":["半夏"],"skos:definition":{"@value":"반하의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia-ferment","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하곡","@language":"ko"},"skos:altLabel":["半夏曲"],"skos:definition":{"@value":"처방의 반하곡 약미와 본초 문서를 연결하는 개념. 원문 약명·가공·약용 부위와 조제 조건을 각 수록본에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/pinellia/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangwei-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양위탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양위탕","人參養胃湯","人蔘養胃湯"],"skos:definition":{"@value":"국방 淳祐新添方 인삼양위탕 기본 9미의 일괄 제조 배합. 半夏 湯洗七次·厚朴 去粗皮薑汁製·蒼朮 米泔浸一宿洗切炒 각 一兩, 藿香葉 洗去土·草果 去皮膜·茯苓 去黑皮·人參 각 半兩, 甘草 炙 二錢半, 橘紅 七錢半. 每服四錢·水一盞半·姜七片·烏梅一個·煎至六分·去滓熱服을 보존한다. 생강·오매는 매복 전탕 추가재료이며 대조는 이 수록형에 없다. 후대 방약합편의 진피·적복령·생강3편·대조2매와 구분하고 제조 총량을 현대 1일량으로 환산하지 않는다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangwei-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-baizhu-tianma-piwei--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 1전5分 | 뜨거운 물로 7회 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"비위론 13미 수록형. 황백 二分·주세, 건강 三分, 천마·창출·백복령·황기·택사·인삼 각 五分, 백출·炒曲 각 一錢, 반하 湯洗七次·대맥얼면·귤피 각 一錢五分. 매회 半兩을 물 二盞에서 一盞으로 달여 거재·열복·식전. 동의보감의 생강 5쪽 추가는 별도 수록형이며 이 기본 구성에 합치지 않는다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-houpo-jinkui--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-houpo-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-houpo-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 1승 | 별도 포제 표기 없음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"금궤요략 부인잡병편의 기본 5미. 반하 1승은 부피, 후박 3량·복령 4량·생강 5량·건소엽 2량은 중량 기록이다. 건소엽은 말린 잎의 원문 명칭으로 보존하며, 후대 대칠기탕의 조말·생강 추가 방식과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-xiexin-shanghan--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-xiexin-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-xiexin-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 반승 | 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"상한론 송본 반하사심탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 반승, 포제 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-baohe-danxi--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#baohe-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/baohe-wan/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 3량 | 별도 포제 표기 없음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"단계심법 積聚痞塊五十四의 기본 7미. 산사 六兩·신곡 二兩·반하와 복령 각 三兩·진피와 연교 및 蘿蔔子 각 一兩. 분말을 炊餅으로 梧子大 환제로 만들고 每服七八十丸·食遠白湯下로 기록한다. 전체 제조 배합과 매회 환수를 구분하고 현대 1환/1회량을 추정하지 않는다. 백출·황금 등의 우방과 단계치법심요의 다른 약량은 별도 기록으로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-erchen-guofang--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#erchen-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/erchen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 5량 | 뜨거운 물로 7회 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"국방 이진탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 5량, 포제 뜨거운 물로 7회 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-huoxiang-zhengqi-guofang--containsHerb--pinellia-ferment","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huoxiang-zhengqi-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia-ferment"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/huoxiang-zhengqi-san/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏曲 | 2량 | 반하곡: 발효 가공 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"국방 곽향정기산의 기본 구성. 원문 약명 半夏曲, 수록량 2량, 포제 반하곡: 발효 가공. 역사적 배합량과 현대 제제·1일량을 구분한다. 半夏曲의 발효 가공을 보존하여 법제 반하와 별도 개념으로 연결한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-erchen-yixuezhengzhuan--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-erchen-yixuezhengzhuan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jeongjeon-gami-ijin-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 一錢 | 湯泡洗·뜨거운 물에 담가 씻음 |"},"skos:scopeNote":{"@value":"의학정전 加味二陳湯의 導痰補脾·消食行氣 수록형. 기본 12미의 橘紅·茯苓 각 七分, 半夏 湯泡洗 一錢, 甘草 炙 三分, 川芎·蒼朮·白朮 각 八分, 山楂肉 一錢五分, 砂仁 五分, 神麯 炒 七分, 香附子 一錢, 麥糵面 炒 五分. 生薑 三片·大棗 一枚는 전탕 추가재료. 神麯·麥糵面을 細研炒另包하고 나머지는 細切作一服하여 水二盞煎至一盞 후 두 분말을 調入한다. 모든 약미를 함께 전탕하는 것으로 바꾸지 않는다. 후대 방약합편의 백복령·대조 二枚 및 g 환산과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-bangyak--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"},"dcterms:description":{"@value":"| 반하 | 3 g |"},"skos:scopeNote":{"@value":"방약합편 가미온담탕B P0004114에 제시된 국내 11미형과 DB 환산 용량. 향부자 9 g·귤홍 4.5 g·반하/죽여/지실 각 3 g·길경/맥문동/백복령/시호/인삼 각 2.25 g·감초 1.5 g. 생강 3편·대조 2매는 전탕 추가재료. 만병회춘의 숙지황·산조인·원지·오미자형 및 역사적 단위와 구분한다. DB 환산량을 고전 원문 g 표기로 대체하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-wanbing--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 3전반 | 7회 담금 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"만병회춘 허번의 기본 11미. 반하 泡七次 三錢半, 죽여·지실 麩炒 각 一錢半, 진피 二錢二分, 복령·감초 各一錢，一分의 공개 전사 표기를 보존하고 확정량으로 정규화하지 않는다. 산조인 炒·원지 去心·오미자·인삼·숙지황 각 一錢. 上銼一劑·薑棗煎服은 생강·대조를 더하는 전탕 조건이며 개수는 미기재다. 방약합편 향부자·맥문동형과 구성·약량을 구분한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liujunzi-yixuexinwu--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 1전 | 뜨거운 물에 7회 담금 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"의학심오 수록형. 인삼·복령·백출·진피·감초·반하의 기본 6미에 생강·대조를 포함한다. 백출 진토초·진피 거백·감초 자·반하 탕포칠차 등 원문 포제를 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuyu-yixuerumen--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-yixuerumen"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md)·[반하](../herbs/pinellia.md)·[천궁](../herbs/chuanxiong.md)·[창출](../herbs/atractylodes-lancea.md) | 각 1전 |"},"skos:scopeNote":{"@value":"의학입문 郁類의 기본 9미. 진피·반하·천궁·창출 각 一錢, 적복령·산치자인 각 七分, 향부 二錢, 사인·감초 각 五分. 생강 三片은 별도 전탕 추가재료. 水煎服·隨證加減을 보존하고 개별 포제 미기재를 다른 수록형에서 채워 넣지 않는다. 동의보감 의감 인용 12미형 및 DB 환산량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-maimendong-jinkui--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maimendong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/maidong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 1승 | 별도 포제 표기 없음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"금궤요략 맥문동탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 1승, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangwei-guofang--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangwei-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangwei-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 一兩 | 湯洗七次 |"},"skos:scopeNote":{"@value":"국방 淳祐新添方 인삼양위탕 기본 9미의 일괄 제조 배합. 半夏 湯洗七次·厚朴 去粗皮薑汁製·蒼朮 米泔浸一宿洗切炒 각 一兩, 藿香葉 洗去土·草果 去皮膜·茯苓 去黑皮·人參 각 半兩, 甘草 炙 二錢半, 橘紅 七錢半. 每服四錢·水一盞半·姜七片·烏梅一個·煎至六分·去滓熱服을 보존한다. 생강·오매는 매복 전탕 추가재료이며 대조는 이 수록형에 없다. 후대 방약합편의 진피·적복령·생강3편·대조2매와 구분하고 제조 총량을 현대 1일량으로 환산하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 2량 | 뜨거운 물로 7회 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 2량, 포제 뜨거운 물로 7회 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiangsha-liujunzi-shifang--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 2전 | 별도 포제 표기 없음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"시방가괄 향사육군자탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 2전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 반승 | 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 반승, 포제 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaoqinglong-shanghan--containsHerb--pinellia","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pinellia"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [반하](../herbs/pinellia.md) · 半夏 | 반승 | 씻음 | 화담·강역으로 담습과 오심을 함께 다룸 |"},"skos:scopeNote":{"@value":"상한론 송본 소청룡탕의 구성표 기본 약미. 원문 약명 半夏, 수록량 반승, 포제 씻음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"온담탕 — 삼인극일병증방론 수록형","@language":"ko"},"skos:altLabel":["온담탕","溫膽湯"],"skos:definition":{"@value":"삼인극일병증방론의 온담탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"향사육군자탕 — 시방가괄 수록형","@language":"ko"},"skos:altLabel":["향사육군자탕","香砂六君子湯"],"skos:definition":{"@value":"시방가괄의 향사육군자탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소시호탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["소시호탕","小柴胡湯"],"skos:definition":{"@value":"상한론 송본의 소시호탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaoqinglong-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소청룡탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["소청룡탕","小靑龍湯","小青龍湯"],"skos:definition":{"@value":"상한론 송본의 소청룡탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaoqinglong-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
