{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"황기","@language":"ko"},"skos:altLabel":["黃耆","黃芪"],"skos:definition":{"@value":"처방의 황기 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/astragalus/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하백출천마탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["반하백출천마탕","半夏白朮天麻湯"],"skos:definition":{"@value":"비위론의 기본 13미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#buzhong-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"보중익기탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["보중익기탕","補中益氣湯"],"skos:definition":{"@value":"비위론의 보중익기탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/buzhong-yiqi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#danggui-buxue-neiwaishang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"당귀보혈탕 — 내외상변혹론 수록형","@language":"ko"},"skos:altLabel":["당귀보혈탕","當歸補血湯"],"skos:definition":{"@value":"내외상변혹론의 당귀보혈탕 수록형. 해당 구성표의 2개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/danggui-buxue-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"귀비탕 — 동의보감 수록형","@language":"ko"},"skos:altLabel":["귀비탕","歸脾湯"],"skos:definition":{"@value":"동의보감 내경편 권1 신·건망의 귀비탕. 당귀·원지를 포함한 10미와 전탕 추가 생강·대추를 기록한 수록형.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#donguibogam-version"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-jisheng","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"귀비탕 — 제생방 수록형","@language":"ko"},"skos:altLabel":["귀비탕","歸脾湯"],"skos:definition":{"@value":"제생방의 귀비탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huangqi-guizhi-wuwu-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"황기계지오물탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["황기계지오물탕","黃耆桂枝五物湯"],"skos:definition":{"@value":"금궤요략의 황기계지오물탕 수록형. 구성표의 기본 5미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/huangqi-guizhi-wuwu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huangqi-jianzhong-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"황기건중탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["황기건중탕","黃耆建中湯"],"skos:definition":{"@value":"금궤요략의 황기건중탕 수록형. 구성표의 기본 7미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/huangqi-jianzhong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양영탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양영탕","人參養榮湯"],"skos:definition":{"@value":"국방의 인삼양영탕 수록형. 구성표의 기본 12미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"십전대보탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["십전대보탕","十全大補湯"],"skos:definition":{"@value":"국방의 십전대보탕 수록형. 해당 구성표의 10개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"쌍화탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["쌍화탕","雙和湯"],"skos:definition":{"@value":"국방의 쌍화탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-baizhu-tianma-piwei--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 5分 | 별도 포제 표기 없음 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"비위론 13미 수록형. 황백 二分·주세, 건강 三分, 천마·창출·백복령·황기·택사·인삼 각 五分, 백출·炒曲 각 一錢, 반하 湯洗七次·대맥얼면·귤피 각 一錢五分. 매회 半兩을 물 二盞에서 一盞으로 달여 거재·열복·식전. 동의보감의 생강 5쪽 추가는 별도 수록형이며 이 기본 구성에 합치지 않는다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-buzhong-piwei--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#buzhong-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/buzhong-yiqi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 五分（병심·노역열 때 1전） | 별도 포제 표기 없음 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"비위론 보중익기탕의 구성표 기본 약미. 원문 약명 黃耆, 수록량 五分（병심·노역열 때 1전）, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-danggui-buxue-neiwaishang--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#danggui-buxue-neiwaishang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/danggui-buxue-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 1량 | 별도 포제 표기 없음 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"내외상변혹론 당귀보혈탕의 구성표 기본 약미. 원문 약명 黃耆, 수록량 1량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-guibi-donguibogam--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#donguibogam-version"},"dcterms:description":{"@value":"| 당귀·용안육·산조인·원지·인삼·황기·백출·복신 | 각 1전; 산조인은 초(炒), 원지는 제(製) |"},"skos:scopeNote":{"@value":"동의보감 내경편 신·건망의 의학입문 인용 수록형. 이 행의 8미 각 1전; 산조인 초·원지 제. 제생방 8미형과 당귀·원지의 유무를 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-guibi-jisheng--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-jisheng"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 1량 | 노두 제거 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"제생방 귀비탕의 구성표 기본 약미. 원문 약명 黃耆, 수록량 1량, 포제 노두 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-huangqi-guizhi-wuwu-jinkui--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huangqi-guizhi-wuwu-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/huangqi-guizhi-wuwu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 3량 | 별도 포제 표기 없음 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"금궤요략 황기계지오물탕의 기본 구성. 원문 약명 黃耆, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-huangqi-jianzhong-jinkui--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huangqi-jianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/huangqi-jianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 1량반 | 별도 포제 표기 없음 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"금궤요략 황기건중탕의 기본 구성. 원문 약명 黃耆, 수록량 1량반, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다. 금궤 6.13의 소건중탕과 6.14의 황기 가미를 연결한 기존 구성표다. 감초 3량·대조 12매를 유지하며 조건별 가감은 따로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangrong-guofang--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 1량 | 별도 포제 표기 없음 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"국방 인삼양영탕의 기본 구성. 원문 약명 黃耆, 수록량 1량, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shiquan-guofang--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 등분 | 노두 제거 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"국방 십전대보탕의 구성표 기본 약미. 원문 약명 黃耆, 수록량 등분, 포제 노두 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 3량 | 꿀로 자제 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 黃耆, 수록량 3량, 포제 꿀로 자제. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yupingfeng-danxi--containsHerb--astragalus","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yupingfeng-danxi"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#astragalus"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yupingfeng-san/#source-dose-original"},"dcterms:description":{"@value":"| [황기](../herbs/astragalus.md) · 黃耆 | 1량 | 별도 포제 표기 없음 | 기를 보하고 고표·회복의 바탕을 받침 |"},"skos:scopeNote":{"@value":"단계심법 옥병풍산의 기본 구성. 원문 약명 黃耆, 수록량 1량, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yupingfeng-danxi","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"옥병풍산 — 단계심법 수록형","@language":"ko"},"skos:altLabel":["옥병풍산","玉屏風散"],"skos:definition":{"@value":"단계심법의 옥병풍산 수록형. 구성표의 기본 3미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yupingfeng-san/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
