{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"팔진탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["팔진탕","八珍湯","팔물탕","八物湯"],"skos:definition":{"@value":"만병회춘의 팔진탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chaihu-shugan-jingyue","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"시호소간산 — 경악전서 수록형","@language":"ko"},"skos:altLabel":["시호소간산","柴胡疏肝散"],"skos:definition":{"@value":"경악전서의 기본 7미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/chaihu-shugan-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"천궁","@language":"ko"},"skos:altLabel":["芎藭"],"skos:definition":{"@value":"천궁의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/chuanxiong/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#danggui-shaoyao-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"당귀작약산 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["당귀작약산","當歸芍藥散"],"skos:definition":{"@value":"금궤요략의 당귀작약산 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/danggui-shaoyao-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#duhuo-jisheng-qianjin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"독활기생탕 — 비급천금요방 수록형","@language":"ko"},"skos:altLabel":["독활기생탕","獨活寄生湯"],"skos:definition":{"@value":"비급천금요방의 독활기생탕 수록형. 해당 구성표의 15개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/duhuo-jisheng-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-erchen-yixuezhengzhuan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"정전가미이진탕 — 의학정전 도담보비 수록형","@language":"ko"},"skos:altLabel":["정전가미이진탕","正傳加味二陳湯"],"skos:definition":{"@value":"의학정전 加味二陳湯의 導痰補脾·消食行氣 수록형. 기본 12미의 橘紅·茯苓 각 七分, 半夏 湯泡洗 一錢, 甘草 炙 三分, 川芎·蒼朮·白朮 각 八分, 山楂肉 一錢五分, 砂仁 五分, 神麯 炒 七分, 香附子 一錢, 麥糵面 炒 五分. 生薑 三片·大棗 一枚는 전탕 추가재료. 神麯·麥糵面을 細研炒另包하고 나머지는 細切作一服하여 水二盞煎至一盞 후 두 분말을 調入한다. 모든 약미를 함께 전탕하는 것으로 바꾸지 않는다. 후대 방약합편의 백복령·대조 二枚 및 g 환산과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jeongjeon-gami-ijin-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-donguibogam-uigam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육울탕 — 동의보감 의감 인용 12미 수록형","@language":"ko"},"skos:altLabel":["육울탕","六鬱湯"],"skos:definition":{"@value":"동의보감 잡병편 적취의 醫鑑 인용 12미형과 생강. 향부자·창출·신곡·치자·연교·陳皮·천궁·적복령·貝母·지각·자소엽 각 一錢, 감초 五分, 생강 三片 전탕 추가. 便香附는 가공 표기를 보존하며 세부 공정은 해당 대목 미기재다. 神塂·赤茯巔은 전사 표기로 원문에 유지한다. 貝母는 기원종을 확정하지 않는다. 剉作一貼·水煎服을 보존하고 DB 秦皮 연결 및 현대 g 환산값을 이 고전의 기록과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#donguibogam-uigam-version"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-yixuerumen","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육울탕 — 의학입문 9미 수록형","@language":"ko"},"skos:altLabel":["육울탕","六鬱湯"],"skos:definition":{"@value":"의학입문 郁類의 기본 9미. 진피·반하·천궁·창출 각 一錢, 적복령·산치자인 각 七分, 향부 二錢, 사인·감초 각 五分. 생강 三片은 별도 전탕 추가재료. 水煎服·隨證加減을 보존하고 개별 포제 미기재를 다른 수록형에서 채워 넣지 않는다. 동의보감 의감 인용 12미형 및 DB 환산량과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"십전대보탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["십전대보탕","十全大補湯"],"skos:definition":{"@value":"국방의 십전대보탕 수록형. 해당 구성표의 10개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shujing-huoxue-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소경활혈탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["소경활혈탕","疏經活血湯"],"skos:definition":{"@value":"만병회춘의 소경활혈탕 수록형. 해당 구성표의 16개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shujing-huoxue-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#siwu-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"사물탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["사물탕","四物湯"],"skos:definition":{"@value":"국방의 사물탕 수록형. 해당 구성표의 4개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/siwu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"쌍화탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["쌍화탕","雙和湯"],"skos:definition":{"@value":"국방의 쌍화탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-bazhen-wanbing--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#bazhen-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/bazhen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 1전 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"만병회춘 팔진탕의 구성표 기본 약미. 원문 약명 川芎, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-chaihu-shugan-jingyue--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chaihu-shugan-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/chaihu-shugan-san/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 1전반 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"경악전서 7미 수록형. 진피 醋炒·시호 각 二錢, 천궁·지각 麩炒·작약·향부자 각 一錢半, 감초 炙 五分. 원문 芍藥을 보존하며 지각과 지실을 구분한다. 물 一鍾半·煎八分·식전 복용은 전탕 조건으로 기록하고 감초 五分의 약량과 구분한다. 현대 급여 시호소간탕 및 연구 가감방의 약량·제형은 각각 확인한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-danggui-shaoyao-jinkui--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#danggui-shaoyao-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/danggui-shaoyao-san/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 芎藭 | 반근, 이본 부기 3량 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"금궤요략 당귀작약산의 구성표 기본 약미. 원문 약명 芎藭, 수록량 반근, 이본 부기 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-duhuo-jisheng-qianjin--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#duhuo-jisheng-qianjin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/duhuo-jisheng-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 2량 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"비급천금요방 독활기생탕의 구성표 기본 약미. 원문 약명 川芎, 수록량 2량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-erchen-yixuezhengzhuan--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-erchen-yixuezhengzhuan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jeongjeon-gami-ijin-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 八分 | 별도 포제 표기 없음 |"},"skos:scopeNote":{"@value":"의학정전 加味二陳湯의 導痰補脾·消食行氣 수록형. 기본 12미의 橘紅·茯苓 각 七分, 半夏 湯泡洗 一錢, 甘草 炙 三分, 川芎·蒼朮·白朮 각 八分, 山楂肉 一錢五分, 砂仁 五分, 神麯 炒 七分, 香附子 一錢, 麥糵面 炒 五分. 生薑 三片·大棗 一枚는 전탕 추가재료. 神麯·麥糵面을 細研炒另包하고 나머지는 細切作一服하여 水二盞煎至一盞 후 두 분말을 調入한다. 모든 약미를 함께 전탕하는 것으로 바꾸지 않는다. 후대 방약합편의 백복령·대조 二枚 및 g 환산과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuyu-donguibogam-uigam--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-donguibogam-uigam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#donguibogam-uigam-version"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 一錢 |"},"skos:scopeNote":{"@value":"동의보감 잡병편 적취의 醫鑑 인용 12미형과 생강. 향부자·창출·신곡·치자·연교·陳皮·천궁·적복령·貝母·지각·자소엽 각 一錢, 감초 五分, 생강 三片 전탕 추가. 便香附는 가공 표기를 보존하며 세부 공정은 해당 대목 미기재다. 神塂·赤茯巔은 전사 표기로 원문에 유지한다. 貝母는 기원종을 확정하지 않는다. 剉作一貼·水煎服을 보존하고 DB 秦皮 연결 및 현대 g 환산값을 이 고전의 기록과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liuyu-yixuerumen--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liuyu-yixuerumen"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yukwul-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md)·[반하](../herbs/pinellia.md)·[천궁](../herbs/chuanxiong.md)·[창출](../herbs/atractylodes-lancea.md) | 각 1전 |"},"skos:scopeNote":{"@value":"의학입문 郁類의 기본 9미. 진피·반하·천궁·창출 각 一錢, 적복령·산치자인 각 七分, 향부 二錢, 사인·감초 각 五分. 생강 三片은 별도 전탕 추가재료. 水煎服·隨證加減을 보존하고 개별 포제 미기재를 다른 수록형에서 채워 넣지 않는다. 동의보감 의감 인용 12미형 및 DB 환산량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shiquan-guofang--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shiquan-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shi-quan-da-bu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 등분 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"국방 십전대보탕의 구성표 기본 약미. 원문 약명 川芎, 수록량 등분, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shujing-huoxue-wanbing--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shujing-huoxue-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shujing-huoxue-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎草 | 6푼 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"만병회춘 소경활혈탕의 구성표 기본 약미. 원문 약명 川芎草, 수록량 6푼, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-siwu-guofang--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#siwu-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/siwu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 등분 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"국방 사물탕의 구성표 기본 약미. 원문 약명 川芎, 수록량 등분, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-ssanghwa-guofang--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#ssanghwa-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/ssanghwa-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 川芎 | 3량 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"국방 쌍화탕의 구성표 기본 약미. 원문 약명 川芎, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-suanzaoren-jinkui--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#suanzaoren-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/suanzaoren-tang/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 芎藭 | 2량 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"금궤요략 5미 수록형. 深師有生薑二兩는 이본 주석으로 구별한다. 산조인 부피 단위와 다른 약미의 중량 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-yueju-yifang--containsHerb--chuanxiong","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yueju-yifang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chuanxiong"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/yueju-wan/#source-dose-original"},"dcterms:description":{"@value":"| [천궁](../herbs/chuanxiong.md) · 撫芎 | 등분 | 별도 포제 표기 없음 | 혈분의 정체와 기체를 함께 풀어 줌 |"},"skos:scopeNote":{"@value":"의방집해 월국환 기본 5미 등분. 향부 醋炒·창출 泔浸炒·撫芎·신곡 炒·치자 炒黑. 曲糊為丸은 곡호 제환 기록이며 단계심법의 水丸과 구분한다. 기본 5미의 상대비와 현대 1회량을 구분하고 반하·남성·과루·산사·사인 등 조건부 가미를 기본 구성으로 합치지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#suanzaoren-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"산조인탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["산조인탕","酸棗仁湯"],"skos:definition":{"@value":"금궤요략 허로편의 산조인·지모·복령·천궁·감초 5미 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/suanzaoren-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#yueju-yifang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"월국환 — 의방집해 수록형","@language":"ko"},"skos:altLabel":["월국환","越鞠丸"],"skos:definition":{"@value":"의방집해 월국환 기본 5미 등분. 향부 醋炒·창출 泔浸炒·撫芎·신곡 炒·치자 炒黑. 曲糊為丸은 곡호 제환 기록이며 단계심법의 水丸과 구분한다. 기본 5미의 상대비와 현대 1회량을 구분하고 반하·남성·과루·산사·사인 등 조건부 가미를 기본 구성으로 합치지 않는다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/yueju-wan/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
