{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-xiexin-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하사심탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["반하사심탕","半夏瀉心湯"],"skos:definition":{"@value":"상한론 송본의 반하사심탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-xiexin-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gegen-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"갈근탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["갈근탕","葛根湯"],"skos:definition":{"@value":"상한론 송본의 갈근탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/gegen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"귀비탕 — 동의보감 수록형","@language":"ko"},"skos:altLabel":["귀비탕","歸脾湯"],"skos:definition":{"@value":"동의보감 내경편 권1 신·건망의 귀비탕. 당귀·원지를 포함한 10미와 전탕 추가 생강·대추를 기록한 수록형.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#donguibogam-version"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guizhi-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"계지탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["계지탕","桂枝湯"],"skos:definition":{"@value":"상한론 송본의 계지탕 수록형. 해당 구성표의 5개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/guizhi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huangqi-guizhi-wuwu-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"황기계지오물탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["황기계지오물탕","黃耆桂枝五物湯"],"skos:definition":{"@value":"금궤요략의 황기계지오물탕 수록형. 구성표의 기본 5미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/huangqi-guizhi-wuwu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huangqi-jianzhong-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"황기건중탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["황기건중탕","黃耆建中湯"],"skos:definition":{"@value":"금궤요략의 황기건중탕 수록형. 구성표의 기본 7미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/huangqi-jianzhong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-erchen-yixuezhengzhuan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"정전가미이진탕 — 의학정전 도담보비 수록형","@language":"ko"},"skos:altLabel":["정전가미이진탕","正傳加味二陳湯"],"skos:definition":{"@value":"의학정전 加味二陳湯의 導痰補脾·消食行氣 수록형. 기본 12미의 橘紅·茯苓 각 七分, 半夏 湯泡洗 一錢, 甘草 炙 三分, 川芎·蒼朮·白朮 각 八分, 山楂肉 一錢五分, 砂仁 五分, 神麯 炒 七分, 香附子 一錢, 麥糵面 炒 五分. 生薑 三片·大棗 一枚는 전탕 추가재료. 神麯·麥糵面을 細研炒另包하고 나머지는 細切作一服하여 水二盞煎至一盞 후 두 분말을 調入한다. 모든 약미를 함께 전탕하는 것으로 바꾸지 않는다. 후대 방약합편의 백복령·대조 二枚 및 g 환산과 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jeongjeon-gami-ijin-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 방약합편 향부자·맥문동 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"방약합편 가미온담탕B P0004114의 기본 11미와 전탕 생강·대조를 기록한 별도 수록형.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 만병회춘 허번 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"만병회춘의 기본 11미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"대조","@language":"ko"},"skos:altLabel":["大棗"],"skos:definition":{"@value":"대조의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/jujube-fruit/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육군자탕 — 의학심오 수록형","@language":"ko"},"skos:altLabel":["육군자탕","六君子湯"],"skos:definition":{"@value":"의학심오의 복령 포함 여섯 기본 약미와 생강·대조를 함께 기록한 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maimendong-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"맥문동탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["맥문동탕","麥門冬湯"],"skos:definition":{"@value":"금궤요략의 맥문동탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/maidong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양영탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양영탕","人參養榮湯"],"skos:definition":{"@value":"국방의 인삼양영탕 수록형. 구성표의 기본 12미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#samchul-geonbi-donguibogam","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"삼출건비탕 — 동의보감 집략 인용 수록형","@language":"ko"},"skos:altLabel":["삼출건비탕","參朮健脾湯","蔘朮健脾湯"],"skos:definition":{"@value":"동의보감 잡병편 권4 내상 食傷補益之劑의 集略 인용 삼출건비탕 기본 12미와 전탕 생강·대조. 인삼·백출·白茯苓·후박·陳皮·山査肉 각 一錢, 枳實·白芍藥 각 八分, 神麴·麥芽·縮砂·甘草 각 五分. 剉作一貼·入薑三棗二水煎服 기록을 보존하고 제법 대조의 생강 3쪽·대조 2매를 전탕 추가재료로 구분한다. 해당 대목의 포제 미기재를 후대 처방으로 채우지 않는다. 지실을 뺀 2002년 해설서 B형 및 현대 DB g 환산량과 구분하며, 정전가미이진탕의 신곡·맥아면 별포·조입 조건을 가져오지 않는다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/samchul-geonbi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-xiexin-shanghan--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-xiexin-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-xiexin-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 12매 | 쪼갬 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"상한론 송본 반하사심탕의 구성표 기본 약미. 원문 약명 大棗, 수록량 12매, 포제 쪼갬. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-gegen-shanghan--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gegen-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/gegen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 12매 | 쪼갬 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"상한론 송본 갈근탕의 구성표 기본 약미. 원문 약명 大棗, 수록량 12매, 포제 쪼갬. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-guibi-donguibogam--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guibi-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/guibi-tang/#donguibogam-version"},"dcterms:description":{"@value":"| 생강·대추 | 5편·2매, 달일 때 더함 |"},"skos:scopeNote":{"@value":"동의보감 귀비탕의 전탕 추가 대추 2매. 역사적 수록량과 현대 1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-guizhi-shanghan--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#guizhi-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/guizhi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 12매 | 쪼갬 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"상한론 송본 계지탕의 구성표 기본 약미. 원문 약명 大棗, 수록량 12매, 포제 쪼갬. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-huangqi-guizhi-wuwu-jinkui--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huangqi-guizhi-wuwu-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/huangqi-guizhi-wuwu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 12매 | 별도 포제 표기 없음 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"금궤요략 황기계지오물탕의 기본 구성. 원문 약명 大棗, 수록량 12매, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-huangqi-jianzhong-jinkui--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huangqi-jianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/huangqi-jianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 12매 | 별도 포제 표기 없음 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"금궤요략 황기건중탕의 기본 구성. 원문 약명 大棗, 수록량 12매, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다. 금궤 6.13의 소건중탕과 6.14의 황기 가미를 연결한 기존 구성표다. 감초 3량·대조 12매를 유지하며 조건별 가감은 따로 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-erchen-yixuezhengzhuan--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-erchen-yixuezhengzhuan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jeongjeon-gami-ijin-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 一枚 | 전탕 추가재료 |"},"skos:scopeNote":{"@value":"의학정전 加味二陳湯의 導痰補脾·消食行氣 수록형. 기본 12미의 橘紅·茯苓 각 七分, 半夏 湯泡洗 一錢, 甘草 炙 三分, 川芎·蒼朮·白朮 각 八分, 山楂肉 一錢五分, 砂仁 五分, 神麯 炒 七分, 香附子 一錢, 麥糵面 炒 五分. 生薑 三片·大棗 一枚는 전탕 추가재료. 神麯·麥糵面을 細研炒另包하고 나머지는 細切作一服하여 水二盞煎至一盞 후 두 분말을 調入한다. 모든 약미를 함께 전탕하는 것으로 바꾸지 않는다. 후대 방약합편의 백복령·대조 二枚 및 g 환산과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-bangyak--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"},"dcterms:description":{"@value":"**가미:** 생강 3편, 대조 2매"},"skos:scopeNote":{"@value":"방약합편 가미온담탕B P0004114에 제시된 국내 11미형과 DB 환산 용량. 향부자 9 g·귤홍 4.5 g·반하/죽여/지실 각 3 g·길경/맥문동/백복령/시호/인삼 각 2.25 g·감초 1.5 g. 생강 3편·대조 2매는 전탕 추가재료. 만병회춘의 숙지황·산조인·원지·오미자형 및 역사적 단위와 구분한다. DB 환산량을 고전 원문 g 표기로 대체하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-wanbing--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"원문 제법은 「上銼一劑。薑、棗煎服。」으로, 한 제를 썰어 생강·대조와 달인다고 기록합니다. 생강·대조의 개수는 이 기록에 없습니다."},"skos:scopeNote":{"@value":"만병회춘 허번의 기본 11미. 반하 泡七次 三錢半, 죽여·지실 麩炒 각 一錢半, 진피 二錢二分, 복령·감초 各一錢，一分의 공개 전사 표기를 보존하고 확정량으로 정규화하지 않는다. 산조인 炒·원지 去心·오미자·인삼·숙지황 각 一錢. 上銼一劑·薑棗煎服은 생강·대조를 더하는 전탕 조건이며 개수는 미기재다. 방약합편 향부자·맥문동형과 구성·약량을 구분한다. 생강·대조는 기본 11미 외 전탕 추가재료이며 개수를 추정하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liujunzi-yixuexinwu--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 2매 | 별도 포제 표기 없음 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"의학심오 수록형. 인삼·복령·백출·진피·감초·반하의 기본 6미에 생강·대조를 포함한다. 백출 진토초·진피 거백·감초 자·반하 탕포칠차 등 원문 포제를 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-maimendong-jinkui--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#maimendong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/maidong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 12매 | 별도 포제 표기 없음 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"금궤요략 맥문동탕의 구성표 기본 약미. 원문 약명 大棗, 수록량 12매, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangrong-guofang--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#fatigue-original-ratio"},"dcterms:description":{"@value":"\u003e 上銼散。每服四錢，水一盞半，生薑三片，棗子二枚，煎至七分，去滓溫服。"},"skos:scopeNote":{"@value":"국방 인삼양영탕의 전탕 추가 재료. 기본 12미의 조말에서 매회 四錢을 취해 생강 三片·대추 二枚와 달이는 기록이며 제조 총량과 매회 전탕량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-samchul-geonbi-donguibogam--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#samchul-geonbi-donguibogam"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/samchul-geonbi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 棗 | 二·제법 대조 2매 | 전탕 추가재료 |"},"skos:scopeNote":{"@value":"동의보감 잡병편 권4 내상 食傷補益之劑의 集略 인용 삼출건비탕 기본 12미와 전탕 생강·대조. 인삼·백출·白茯苓·후박·陳皮·山査肉 각 一錢, 枳實·白芍藥 각 八分, 神麴·麥芽·縮砂·甘草 각 五分. 剉作一貼·入薑三棗二水煎服 기록을 보존하고 제법 대조의 생강 3쪽·대조 2매를 전탕 추가재료로 구분한다. 해당 대목의 포제 미기재를 후대 처방으로 채우지 않는다. 지실을 뺀 2002년 해설서 B형 및 현대 DB g 환산량과 구분하며, 정전가미이진탕의 신곡·맥아면 별포·조입 조건을 가져오지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#preparation-and-dose"},"dcterms:description":{"@value":"| 전탕·복용 | 물 一盞半, 생강 五片, 대추 一枚를 더해 煎七分, 거재 후 식전에 복용 |"},"skos:scopeNote":{"@value":"삼인방 온담탕의 전탕 추가 재료. 기본 6미를 조말로 준비해 每服四大錢을 취하고 생강 五片·대추 一枚를 더하는 기록.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiangsha-liujunzi-shifang--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"\u003e 人參茯苓白朮各二錢。炙甘草一錢。加薑棗煎。"},"skos:scopeNote":{"@value":"시방가괄의 사군자→육군자→향사육군자 전개에서 薑棗를 더해 달이는 기록. 기본 8미와 전탕 추가 생강·대추를 구분하며 추가량을 추정하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaochaihu-shanghan--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | 12매 | 쪼갬 | 비위와 영위를 조화하는 보조축 |"},"skos:scopeNote":{"@value":"상한론 송본 소시호탕의 구성표 기본 약미. 원문 약명 大棗, 수록량 12매, 포제 쪼갬. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-jinkui--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | **20매 / 12매** | 상한론은 擘 표기. 중초·영위 조화 |"},"skos:scopeNote":{"@value":"금궤요략 소건중탕. 비교표의 상한론 / 금궤 열 중 금궤요략 값을 선택: 大棗 12매. 포제·제법의 표기: 상한론은 擘 표기. 중초·영위 조화. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiaojianzhong-shanghan--containsHerb--jujube-fruit","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jujube-fruit"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [대조](../herbs/jujube-fruit.md) · 大棗 | **20매 / 12매** | 상한론은 擘 표기. 중초·영위 조화 |"},"skos:scopeNote":{"@value":"상한론 송본 소건중탕. 비교표의 상한론 / 금궤 열 중 상한론 송본 값을 선택: 大棗 20매. 포제·제법의 표기: 상한론은 擘 표기. 중초·영위 조화. 다른 열의 수량과 합산하지 않고 원 단위를 보존한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"온담탕 — 삼인극일병증방론 수록형","@language":"ko"},"skos:altLabel":["온담탕","溫膽湯"],"skos:definition":{"@value":"삼인극일병증방론의 온담탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"향사육군자탕 — 시방가괄 수록형","@language":"ko"},"skos:altLabel":["향사육군자탕","香砂六君子湯"],"skos:definition":{"@value":"시방가괄의 향사육군자탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaochaihu-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소시호탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["소시호탕","小柴胡湯"],"skos:definition":{"@value":"상한론 송본의 소시호탕 수록형. 해당 구성표의 7개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaochaihu-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-jinkui","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소건중탕 — 금궤요략 수록형","@language":"ko"},"skos:altLabel":["소건중탕","小建中湯"],"skos:definition":{"@value":"금궤요략의 소건중탕 6미 구성. 감초·대조의 수록량과 교이를 나중에 녹이는 제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiaojianzhong-shanghan","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소건중탕 — 상한론 송본 수록형","@language":"ko"},"skos:altLabel":["소건중탕","小建中湯"],"skos:definition":{"@value":"상한론 송본의 소건중탕 6미 구성. 감초·대조의 수록량과 교이를 나중에 녹이는 제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiaojianzhong-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
