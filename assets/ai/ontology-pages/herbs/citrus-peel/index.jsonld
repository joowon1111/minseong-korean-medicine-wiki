{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"반하백출천마탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["반하백출천마탕","半夏白朮天麻湯"],"skos:definition":{"@value":"비위론의 기본 13미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#buzhong-piwei","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"보중익기탕 — 비위론 수록형","@language":"ko"},"skos:altLabel":["보중익기탕","補中益氣湯"],"skos:definition":{"@value":"비위론의 보중익기탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/buzhong-yiqi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chaihu-shugan-jingyue","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"시호소간산 — 경악전서 수록형","@language":"ko"},"skos:altLabel":["시호소간산","柴胡疏肝散"],"skos:definition":{"@value":"경악전서의 기본 7미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/chaihu-shugan-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"진피","@language":"ko"},"skos:altLabel":["陳皮"],"skos:definition":{"@value":"진피의 기원·약용 부위·가공과 배합을 확인하는 본초 개념.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-peel/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-red-peel","@type":["skos:Concept","km:Herb"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"귤홍","@language":"ko"},"skos:altLabel":["橘紅"],"skos:definition":{"@value":"처방의 귤홍 약미와 본초 문서를 연결하는 개념. 원문 약명·기원·약용 부위·가공은 각 수록본과 본문에서 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/herbs/citrus-peel/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#erchen-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"이진탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["이진탕","二陳湯"],"skos:definition":{"@value":"국방의 이진탕 수록형. 해당 구성표의 4개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/erchen-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huoxiang-zhengqi-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"곽향정기산 — 국방 수록형","@language":"ko"},"skos:altLabel":["곽향정기산","藿香正氣散"],"skos:definition":{"@value":"국방의 곽향정기산 수록형. 구성표의 기본 11미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/huoxiang-zhengqi-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 방약합편 향부자·맥문동 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"방약합편 가미온담탕B P0004114의 기본 11미와 전탕 생강·대조를 기록한 별도 수록형.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"가미온담탕 — 만병회춘 허번 수록형","@language":"ko"},"skos:altLabel":["가미온담탕","加味溫膽湯"],"skos:definition":{"@value":"만병회춘의 기본 11미 수록형. 원문 약량·포제·제법과 부재료·대용 조건을 각각 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육군자탕 — 의학심오 수록형","@language":"ko"},"skos:altLabel":["육군자탕","六君子湯"],"skos:definition":{"@value":"의학심오의 복령 포함 여섯 기본 약미와 생강·대조를 함께 기록한 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pingwei-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"평위산 — 국방 수록형","@language":"ko"},"skos:altLabel":["평위산","平胃散"],"skos:definition":{"@value":"국방의 평위산 수록형. 해당 구성표의 4개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/pingwei-san/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"인삼양영탕 — 국방 수록형","@language":"ko"},"skos:altLabel":["인삼양영탕","人參養榮湯"],"skos:definition":{"@value":"국방의 인삼양영탕 수록형. 구성표의 기본 12미와 역사적 약량·포제·제법을 보존한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shujing-huoxue-wanbing","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"소경활혈탕 — 만병회춘 수록형","@language":"ko"},"skos:altLabel":["소경활혈탕","疏經活血湯"],"skos:definition":{"@value":"만병회춘의 소경활혈탕 수록형. 해당 구성표의 16개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/shujing-huoxue-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-baizhu-tianma-piwei--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-baizhu-tianma-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/banxia-baizhu-tianma-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 橘皮 | 1전5分 | 별도 포제 표기 없음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"비위론 13미 수록형. 황백 二分·주세, 건강 三分, 천마·창출·백복령·황기·택사·인삼 각 五分, 백출·炒曲 각 一錢, 반하 湯洗七次·대맥얼면·귤피 각 一錢五分. 매회 半兩을 물 二盞에서 一盞으로 달여 거재·열복·식전. 동의보감의 생강 5쪽 추가는 별도 수록형이며 이 기본 구성에 합치지 않는다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-buzhong-piwei--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#buzhong-piwei"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/buzhong-yiqi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 橘皮 | 二分 또는 三分 | 흰 속껍질을 남김 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"비위론 보중익기탕의 구성표 기본 약미. 원문 약명 橘皮, 수록량 二分 또는 三分, 포제 흰 속껍질을 남김. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-chaihu-shugan-jingyue--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#chaihu-shugan-jingyue"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/chaihu-shugan-san/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 2전 | 식초로 볶음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"경악전서 7미 수록형. 진피 醋炒·시호 각 二錢, 천궁·지각 麩炒·작약·향부자 각 一錢半, 감초 炙 五分. 원문 芍藥을 보존하며 지각과 지실을 구분한다. 물 一鍾半·煎八分·식전 복용은 전탕 조건으로 기록하고 감초 五分의 약량과 구분한다. 현대 급여 시호소간탕 및 연구 가감방의 약량·제형은 각각 확인한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-erchen-guofang--containsHerb--citrus-red-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#erchen-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-red-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/erchen-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 橘紅 | 5량 | 별도 포제 표기 없음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"국방 이진탕의 구성표 기본 약미. 원문 약명 橘紅, 수록량 5량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-huoxiang-zhengqi-guofang--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#huoxiang-zhengqi-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/huoxiang-zhengqi-san/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 2량 | 흰 속껍질 제거 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"국방 곽향정기산의 기본 구성. 원문 약명 陳皮, 수록량 2량, 포제 흰 속껍질 제거. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-bangyak--containsHerb--citrus-red-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-bangyak"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-red-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#_3"},"dcterms:description":{"@value":"| 귤홍 | 4.5 g |"},"skos:scopeNote":{"@value":"방약합편 가미온담탕B P0004114에 제시된 국내 11미형과 DB 환산 용량. 향부자 9 g·귤홍 4.5 g·반하/죽여/지실 각 3 g·길경/맥문동/백복령/시호/인삼 각 2.25 g·감초 1.5 g. 생강 3편·대조 2매는 전탕 추가재료. 만병회춘의 숙지황·산조인·원지·오미자형 및 역사적 단위와 구분한다. DB 환산량을 고전 원문 g 표기로 대체하지 않는다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jiawei-wendan-wanbing--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#jiawei-wendan-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/jiawei-wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 二錢二分 | 별도 포제 표기 없음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"만병회춘 허번의 기본 11미. 반하 泡七次 三錢半, 죽여·지실 麩炒 각 一錢半, 진피 二錢二分, 복령·감초 各一錢，一分의 공개 전사 표기를 보존하고 확정량으로 정규화하지 않는다. 산조인 炒·원지 去心·오미자·인삼·숙지황 각 一錢. 上銼一劑·薑棗煎服은 생강·대조를 더하는 전탕 조건이며 개수는 미기재다. 방약합편 향부자·맥문동형과 구성·약량을 구분한다. 이 관계의 본초·약량·포제는 인용한 구성표 행에서 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liujunzi-yixuexinwu--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 1전 | 흰 속껍질 제거 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"의학심오 수록형. 인삼·복령·백출·진피·감초·반하의 기본 6미에 생강·대조를 포함한다. 백출 진토초·진피 거백·감초 자·반하 탕포칠차 등 원문 포제를 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-pingwei-guofang--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#pingwei-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/pingwei-san/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 3근2량 | 흰 속껍질 제거 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"국방 평위산의 구성표 기본 약미. 원문 약명 陳皮, 수록량 3근2량, 포제 흰 속껍질 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-renshen-yangrong-guofang--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#renshen-yangrong-guofang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/renshen-yangrong-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 1량 | 별도 포제 표기 없음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"국방 인삼양영탕의 기본 구성. 원문 약명 陳皮, 수록량 1량, 포제 별도 포제 표기 없음. 역사적 배합량과 현대 제제·1일량을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-shujing-huoxue-wanbing--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#shujing-huoxue-wanbing"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/shujing-huoxue-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 1전 | 흰 속껍질 제거 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"만병회춘 소경활혈탕의 구성표 기본 약미. 원문 약명 陳皮, 수록량 1전, 포제 흰 속껍질 제거. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 3량 | 별도 포제 표기 없음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"삼인극일병증방론 온담탕의 구성표 기본 약미. 원문 약명 陳皮, 수록량 3량, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-xiangsha-liujunzi-shifang--containsHerb--citrus-peel","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang"},"rdf:predicate":{"@id":"km:containsHerb"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#citrus-peel"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"},"dcterms:description":{"@value":"| [진피](../herbs/citrus-peel.md) · 陳皮 | 1전 | 별도 포제 표기 없음 | 이기·조습으로 팽만과 담습을 조절 |"},"skos:scopeNote":{"@value":"시방가괄 향사육군자탕의 구성표 기본 약미. 원문 약명 陳皮, 수록량 1전, 포제 별도 포제 표기 없음. 역사적 배합의 원 단위이며 현대 1일량·제제량과 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"온담탕 — 삼인극일병증방론 수록형","@language":"ko"},"skos:altLabel":["온담탕","溫膽湯"],"skos:definition":{"@value":"삼인극일병증방론의 온담탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#xiangsha-liujunzi-shifang","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"향사육군자탕 — 시방가괄 수록형","@language":"ko"},"skos:altLabel":["향사육군자탕","香砂六君子湯"],"skos:definition":{"@value":"시방가괄의 향사육군자탕 수록형. 해당 구성표의 8개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/xiangsha-liujunzi-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
