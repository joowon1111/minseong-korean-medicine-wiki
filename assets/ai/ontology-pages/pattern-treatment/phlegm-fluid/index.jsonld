{"@context":{"km":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#","skos":"http://www.w3.org/2004/02/skos/core#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","dcterms":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/"},"@graph":[{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gallbladder-stomach-disharmony","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"담위불화","@language":"ko"},"skos:altLabel":["膽胃不和"],"skos:definition":{"@value":"담과 기의 불화에 명치 답답함·오심·어지럼과 심계·번조·수면 불편이 함께 나타나는 양상을 살피는 전통 변증. 膽胃는 전통 기능·병증의 맥락으로 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#phlegm-stomach-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"육군자탕 — 의학심오 수록형","@language":"ko"},"skos:altLabel":["육군자탕","六君子湯"],"skos:definition":{"@value":"의학심오의 복령 포함 여섯 기본 약미와 생강·대조를 함께 기록한 구성.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/liujunzi-tang/#source-dose-original"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#move-qi-dissipate-binding-transform-phlegm","@type":["skos:Concept","km:TreatmentPrinciple"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"행기산결·강역화담","@language":"ko"},"skos:altLabel":["行氣散結·降逆化痰"],"skos:definition":{"@value":"담기울결에서 기의 소통과 맺힌 양상을 풀고 담·기역을 함께 살피는 전통 치법. 목 이물감·흉민·오심과 긴장·식사의 관계, 실제 연하곤란의 원인 평가를 함께 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#phlegm-qi-binding-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#phlegm-qi-binding","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"담기울결","@language":"ko"},"skos:altLabel":["痰氣鬱結"],"skos:definition":{"@value":"담과 기의 울체가 함께 나타나 목 이물감·흉민·한숨·오심과 긴장·식사의 관계를 살피는 한의학적 변증.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/patterns/phlegm-fluid/#phlegm-qi-binding"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#regulate-qi-transform-phlegm-harmonize-stomach","@type":["skos:Concept","km:TreatmentPrinciple"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"이기화담·화위이담","@language":"ko"},"skos:altLabel":["理氣化痰·和胃利膽"],"skos:definition":{"@value":"담위불화에서 담과 기의 흐름을 조절하고 위의 불편을 함께 살피는 전통 치법. 온담탕 원방·가감방과 실제 제법을 구분한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#phlegm-stomach-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme","@type":"skos:ConceptScheme","dcterms:title":{"@value":"민성 한의학 온톨로지 — 출처 기반 개념·관계","@language":"ko"},"dcterms:hasVersion":"1.0","rdfs:seeAlso":{"@id":"https://wiki.minseong.co.kr/network/#ontology-data"},"skos:scopeNote":{"@value":"기존 본문에서 선별한 개념과 관계. rdf:Statement의 subject·predicate·object는 source와 scopeNote를 함께 읽는다. 문서 탐색 링크는 별도 knowledge-graph.json에 제공한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#spleen-qi-deficiency-with-phlegm","@type":["skos:Concept","km:Pattern"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"비허담습","@language":"ko"},"skos:altLabel":["脾虛痰濕"],"skos:definition":{"@value":"피로·식욕저하·무른 변 등 비위허약에 오심·그득함 등 담습의 양상이 겹치는 변증.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/diagnostics/patterns/phlegm-fluid/"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-gallbladder-stomach-disharmony--hasTraditionalTreatmentPrinciple--regulate-qi-transform-phlegm-harmonize-stomach","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gallbladder-stomach-disharmony"},"rdf:predicate":{"@id":"km:hasTraditionalTreatmentPrinciple"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#regulate-qi-transform-phlegm-harmonize-stomach"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#phlegm-stomach-care"},"dcterms:description":{"@value":"담위불화의 전통 치법은 **이기화담·화위이담(理氣化痰·和胃利膽)**입니다."},"skos:scopeNote":{"@value":"담위불화의 후대 변증·치법 해설. 명치 답답함·오심·심계·수면 불편의 동반 양상을 살피며, 비허담습·심비양허 및 황련온담탕·가미온담탕의 구성과 적용 조건을 구분한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-liujunzi-yixuexinwu--hasTraditionalPatternContext--spleen-qi-deficiency-with-phlegm","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#liujunzi-yixuexinwu"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#spleen-qi-deficiency-with-phlegm"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#spleen-qi-phlegm-care"},"dcterms:description":{"@value":"[육군자탕](../formulas/liujunzi-tang.md#source-dose-original)은 이 비허담습의 맥락에서 비교하는 처방입니다."},"skos:scopeNote":{"@value":"의학심오 육군자탕의 여섯 기본 약미와 생강·대조를 보존하며, 비위허약에 오심·그득함 등 담습이 겹치는 배합 맥락을 비교한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-phlegm-qi-binding--hasTraditionalTreatmentPrinciple--move-qi-dissipate-binding-transform-phlegm","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#phlegm-qi-binding"},"rdf:predicate":{"@id":"km:hasTraditionalTreatmentPrinciple"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#move-qi-dissipate-binding-transform-phlegm"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#phlegm-qi-binding-care"},"dcterms:description":{"@value":"담기울결의 전통 치법은 **행기산결·강역화담(行氣散結·降逆化痰)**입니다."},"skos:scopeNote":{"@value":"담기울결의 후대 변증·치법 해설. 목 이물감·흉민·한숨·오심과 긴장·식사 전후의 변동을 함께 살핀다. 반하후박탕 금궤 5미 수록형의 화담·행기·강역 배합을 비교하며, 비허담습의 익기건비·화담 및 담위불화의 이기화담·화위이담과 구분한다. 실제 연하곤란·연하통·체중감소·출혈은 원인 평가로 연결한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-spleen-qi-deficiency-with-phlegm--hasTraditionalTreatmentPrinciple--tonify-spleen-transform-phlegm","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#spleen-qi-deficiency-with-phlegm"},"rdf:predicate":{"@id":"km:hasTraditionalTreatmentPrinciple"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#tonify-spleen-transform-phlegm"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#spleen-qi-phlegm-care"},"dcterms:description":{"@value":"이때의 전통 치법은 익기건비·화담으로, 비위의 기운을 돕는 배합과 담습·구역을 조절하는 배합을 함께 살핍니다."},"skos:scopeNote":{"@value":"비위허약에 담습·구역이 겹친 비허담습의 치료 방향. 동반 증상과 식사·배변·기력의 경과를 함께 살핀다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-wendan-sanyin--hasTraditionalPatternContext--gallbladder-stomach-disharmony","@type":"rdf:Statement","rdf:subject":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin"},"rdf:predicate":{"@id":"km:hasTraditionalPatternContext"},"rdf:object":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#gallbladder-stomach-disharmony"},"dcterms:source":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"},"dcterms:description":{"@value":"이 삼인방 권9 허번의 온담탕 수록형은 [담위불화](../pattern-treatment/phlegm-fluid.md#phlegm-stomach-care)의 후대 변증·배합 맥락에서 비교합니다."},"skos:scopeNote":{"@value":"삼인극일병증방론 권9 허번의 기본 6미와 매회 전탕하는 생강·대조 수록형을 담위불화의 후대 변증·배합 해설과 연결한다. 원문의 대병후 허번·불면·경계 주치와 후대 해석을 구분하며, 반하 탕세칠차·지실 부초거양, 제조분·매회 四大錢을 보존한다. 동의보감형·황련온담탕·가미온담탕 및 동명 이방은 각각 확인한다.","@language":"ko"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#tonify-spleen-transform-phlegm","@type":["skos:Concept","km:TreatmentPrinciple"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"익기건비·화담","@language":"ko"},"skos:altLabel":["益氣健脾·化痰"],"skos:definition":{"@value":"비허담습에서 비위의 기운을 돕는 배합과 담습·구역을 조절하는 배합을 함께 살피는 전통 치법.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#spleen-qi-phlegm-care"}},{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#wendan-sanyin","@type":["skos:Concept","km:Formula"],"skos:inScheme":{"@id":"https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#scheme"},"skos:prefLabel":{"@value":"온담탕 — 삼인극일병증방론 수록형","@language":"ko"},"skos:altLabel":["온담탕","溫膽湯"],"skos:definition":{"@value":"삼인극일병증방론의 온담탕 수록형. 해당 구성표의 6개 기본 약미와 원문 약량·포제를 확인한다.","@language":"ko"},"foaf:page":{"@id":"https://wiki.minseong.co.kr/formulas/wendan-tang/#source-dose-original"}},{"@id":"km:Acupoint","@type":"rdfs:Class","rdfs:label":{"@value":"경혈","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:ClassicalPassage","@type":"rdfs:Class","rdfs:label":{"@value":"고전 조문","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Formula","@type":"rdfs:Class","rdfs:label":{"@value":"처방 수록형","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Herb","@type":"rdfs:Class","rdfs:label":{"@value":"본초","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Meridian","@type":"rdfs:Class","rdfs:label":{"@value":"경맥","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:Pattern","@type":"rdfs:Class","rdfs:label":{"@value":"한의학 변증","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:TreatmentPrinciple","@type":"rdfs:Class","rdfs:label":{"@value":"치법","@language":"ko"},"rdfs:subClassOf":{"@id":"skos:Concept"}},{"@id":"km:belongsToMeridian","@type":"rdf:Property","rdfs:label":{"@value":"소속 경맥","@language":"ko"},"rdfs:comment":{"@value":"경혈의 소속 경맥을 나타내는 분류 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Acupoint"},"rdfs:range":{"@id":"km:Meridian"}},{"@id":"km:containsHerb","@type":"rdf:Property","rdfs:label":{"@value":"구성 본초","@language":"ko"},"rdfs:comment":{"@value":"명시한 수록형에 포함된 본초. 법제·약용 부위·보조재료 여부는 각 관계의 scope에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Herb"}},{"@id":"km:hasTraditionalPatternContext","@type":"rdf:Property","rdfs:label":{"@value":"전통 변증 맥락","@language":"ko"},"rdfs:comment":{"@value":"처방을 설명하는 전통 변증의 맥락. 관계의 scope에 동반 증후와 적용 범위를 기록한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Pattern"}},{"@id":"km:hasTraditionalTreatmentPrinciple","@type":"rdf:Property","rdfs:label":{"@value":"전통 치법으로 연결함","@language":"ko"},"rdfs:comment":{"@value":"명시한 변증에서 설명하는 전통 치료 방향. 동반 증후와 적용 범위는 각 진술의 출처·조건에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Pattern"},"rdfs:range":{"@id":"km:TreatmentPrinciple"}},{"@id":"km:recordsFormula","@type":"rdf:Property","rdfs:label":{"@value":"조문 수록 처방","@language":"ko"},"rdfs:comment":{"@value":"특정 고전 조문에 명시된 수록형을 연결하는 문헌 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:ClassicalPassage"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesFormulaStructureWith","@type":"rdf:Property","rdfs:label":{"@value":"기본 약미 골격 공유","@language":"ko"},"rdfs:comment":{"@value":"기본 약미 골격의 비교. 개별 수록본의 약량·제법은 각 처방에서 확인한다.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}},{"@id":"km:sharesNameWith","@type":"rdf:Property","rdfs:label":{"@value":"동명 이방","@language":"ko"},"rdfs:comment":{"@value":"이름을 공유하면서 수록본과 구성이 다른 처방을 비교하는 관계.","@language":"ko"},"rdfs:domain":{"@id":"km:Formula"},"rdfs:range":{"@id":"km:Formula"}}]}
