    {
      "@id": "https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-banxia-houpo-jinkui--hasTraditionalPatternContext--phlegm-qi-binding",
      "@type": "rdf:Statement",
      "dcterms:description": {
        "@value": "[반하후박탕](../../formulas/banxia-houpo-tang.md#source-dose-original)은 이 담기울결의 맥락에서 비교하는 처방입니다."
      },
      "dcterms:source": {
        "@id": "https://wiki.minseong.co.kr/diagnostics/patterns/phlegm-fluid/#phlegm-qi-binding"
      },
      "rdf:object": {
        "@id": "https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#phlegm-qi-binding"
      },
      "rdf:predicate": {
        "@id": "km:hasTraditionalPatternContext"
      },
      "rdf:subject": {
        "@id": "https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-houpo-jinkui"
      },
      "skos:scopeNote": {
        "@language": "ko",
        "@value": "금궤요략 5미 수록형을 담기울결의 후대 변증·배합 해설과 연결한다. 목 이물감·흉민·한숨·오심과 긴장·식사의 관계를 함께 살피며, 비허담습과 실제 연하곤란의 감별 및 시험 제형·연구 대상은 해당 본문에서 확인한다."
      }
    },
