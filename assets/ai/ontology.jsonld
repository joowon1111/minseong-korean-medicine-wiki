      "rdf:subject": {
        "@id": "https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#banxia-houpo-jinkui"
      },
      "skos:scopeNote": {
        "@language": "ko",
        "@value": "금궤요략 부인잡병편의 기본 5미. 반하 1승은 부피, 후박 3량·복령 4량·생강 5량·건소엽 2량은 중량 기록이다. 건소엽은 말린 잎의 원문 명칭으로 보존하며, 후대 대칠기탕의 조말·생강 추가 방식과 구분한다."
      }
