    {
      "@id": "https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-spleen-qi-deficiency-with-phlegm--hasTraditionalTreatmentPrinciple--tonify-spleen-transform-phlegm",
      "@type": "rdf:Statement",
      "dcterms:description": {
        "@value": "이때의 전통 치법은 익기건비·화담으로, 비위의 기운을 돕는 배합과 담습·구역을 조절하는 배합을 함께 살핍니다."
      },
      "dcterms:source": {
        "@id": "https://wiki.minseong.co.kr/pattern-treatment/phlegm-fluid/#spleen-qi-phlegm-care"
      },
      "rdf:object": {
