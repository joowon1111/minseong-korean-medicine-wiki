    {
      "@id": "https://wiki.minseong.co.kr/assets/ai/ontology.jsonld#statement-jinkui-06-017--recordsFormula--suanzaoren-jinkui",
      "@type": "rdf:Statement",
      "dcterms:description": {
        "@value": "> 虛勞虛煩不得眠，酸棗仁湯主之。"
      },
      "dcterms:source": {
        "@id": "https://wiki.minseong.co.kr/classics/jinkui-yaolue/chapters/blood-bi-deficiency/#clause-06-017"
      },
